// Reco Video Stitcher - GUI
// Material dark theme (configured via build.rs)

import { Button, VerticalBox, HorizontalBox, Slider, ProgressIndicator, LineEdit, ComboBox, CheckBox, ScrollView, TabWidget, Palette, StyleMetrics } from "std-widgets.slint";

/// Wraps a control with a hover tooltip: shows `tip` in a small popup
/// after a brief hover delay, closes as soon as the pointer leaves.
/// Wrapping (rather than baking hover into every control) keeps this
/// opt-in per usage site - just wrap `Tip { tip: "..."; <control> }`.
component Tip inherits TouchArea {
    in property <string> tip;

    // TouchArea does not auto-size to its children the way a layout
    // does, so a bare `@children` here would collapse to zero size
    // inside the surrounding VerticalBox/HorizontalBox. Route the
    // wrapped content through a real layout and mirror its computed
    // size back onto this TouchArea (same pattern Slint's own Button
    // widget uses: binding min/preferred size from an inner layout).
    inner := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        @children
    }
    min-width: inner.min-width;
    min-height: inner.min-height;
    preferred-width: inner.preferred-width;
    preferred-height: inner.preferred-height;

    changed has-hover => {
        if root.has-hover && root.tip != "" {
            tip-timer.running = true;
        } else {
            tip-timer.running = false;
            popup.close();
        }
    }

    tip-timer := Timer {
        // Long delay is deliberate: a tooltip that appears while you're
        // still moving toward a control (rather than lingering on it) just
        // gets in the way. 5s only fires for a genuine "what does this do"
        // pause, not a pass-through hover.
        interval: 5000ms;
        running: false;
        triggered => {
            self.running = false;
            popup.show();
        }
    }

    // Positioned to the right of the wrapped element rather than below
    // it: most Tip usages wrap a short label sitting directly above the
    // actual slider/control it describes, so a popup below would land
    // right on top of the thing you're about to click. To the side never
    // covers either the label or what follows it.
    popup := PopupWindow {
        x: root.width + 8px;
        y: 0px;
        Rectangle {
            background: #2a2a2a;
            border-radius: 4px;
            border-width: 1px;
            border-color: #444;
            width: tip-text.width + 16px;
            height: tip-text.height + 12px;
            tip-text := Text {
                x: 8px;
                y: 6px;
                text: root.tip;
                color: #eee;
                font-size: 13px;
                wrap: word-wrap;
                width: 200px;
            }
        }
    }
}

/// Minimal boxed number-entry field: a bare `TextInput` in a bordered
/// `Rectangle`, styled to match this app's existing "boxed" display
/// widgets (see the non-editing states of the frame/speed/sync fields
/// below). Deliberately not `std-widgets`' `LineEdit` - its `fluent`
/// style draws a clear ("×") icon inside the field whenever it has focus
/// and non-empty text, with no public property to suppress it. Every
/// numeric field in this app wants Enter-to-commit / Escape-to-cancel
/// editing, not a mouse-only clear button, so callers handle `accepted`
/// (Enter) themselves and `escaped` (Escape) to revert/cancel.
component NumEdit inherits Rectangle {
    in property <bool> enabled: true;
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <length> num-font-size: 11px;
    in property <TextHorizontalAlignment> horizontal-alignment: center;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback escaped();

    forward-focus: input;
    height: 22px;
    background: root.enabled ? #2a2a2a : #202020;
    border-radius: 3px;
    border-width: 1px;
    border-color: input.has-focus ? #6a9fd8 : #444;

    public function select-all() {
        input.select-all();
    }

    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        clip: true;

        placeholder := Text {
            text: root.text == "" ? root.placeholder-text : "";
            color: #666;
            font-size: root.num-font-size;
            horizontal-alignment: root.horizontal-alignment;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }

        input := TextInput {
            text <=> root.text;
            enabled: root.enabled;
            color: root.enabled ? white : #666;
            font-size: root.num-font-size;
            horizontal-alignment: root.horizontal-alignment;
            vertical-alignment: center;
            single-line: true;
            width: 100%;
            height: 100%;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.escaped();
                    return accept;
                }
                return reject;
            }
        }
    }
}

/// One labeled slider row for the controls panel. The value display
/// doubles as a text input: double-click it to type an exact value
/// instead of dragging the slider. Commits on Enter or on clicking away,
/// Escape cancels and reverts to the last committed value; clamped to
/// [minimum, maximum] like the slider itself.
///
/// Takes its own optional `tip` and wraps only the label in `Tip`
/// internally, rather than callers wrapping the whole `LabeledSlider` in
/// a `Tip`. `Tip` inherits `TouchArea` and mirrors its size from its
/// child's layout info; wrapping it around the double-click-to-edit
/// value (whose subtree shape toggles between a `TouchArea` and a
/// `LineEdit` row) risked the same class of geometry re-entrancy as the
/// bug documented below, so it's kept scoped to the static label.
///
/// Separately: the edit-mode `LineEdit` defers its focus() call by one
/// tick (see the `Timer` below) instead of calling it from `init`.
/// Calling `.focus()` synchronously from `init` re-enters Slint's
/// geometry evaluation *while the current layout pass (triggered by this
/// same `if !editing -> editing` branch swap) hasn't finished settling*
/// - inside a `ScrollView`, focusing a widget also computes clip-rect
/// geometry up the whole ancestor chain to scroll it into view, and
/// doing that mid-layout-pass hit a real Slint 1.15.1 "Recursion
/// detected" panic that killed the whole app. Reproduced with
/// `RUST_BACKTRACE=1`: just double-clicking a value crashed it, before
/// any typing - the panic is in `item_geometry`/
/// `absolute_clip_rect_and_geometry`, not in anything commit-edit-related.
component LabeledSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> tip: "";
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <string> suffix: "";
    in property <int> decimals: 2;
    in-out property <bool> editing: false;
    // Step size for the optional up/down nudge buttons. `0.0` (default)
    // hides them - most sliders are fine dragged or double-click-typed;
    // some fine-grained params want exact small increments that
    // dragging can't reliably hit.
    in property <float> step: 0.0;
    callback changed(float);

    spacing: 2px;

    property <float> scale:
        root.decimals <= 0 ? 1
      : root.decimals == 1 ? 10
      : root.decimals == 2 ? 100
      : root.decimals == 3 ? 1000
      : root.decimals == 4 ? 10000
      : 100000;
    property <float> display-value:
        root.decimals == 0 ? round(root.value) : round(root.value * root.scale) / root.scale;

    // Takes the typed text rather than reaching into the (conditionally
    // instantiated, so not name-addressable from outside its own `if`
    // branch) LineEdit - both call sites below already have `self.text`
    // in scope since they're callbacks on the LineEdit itself.
    function commit-edit(text: string) {
        root.value = clamp(text.to-float(), root.minimum, root.maximum);
        root.changed(root.value);
        root.editing = false;
    }

    HorizontalLayout {
        Tip {
            tip: root.tip;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: #bbb;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        if !root.editing: TouchArea {
            mouse-cursor: pointer;
            double-clicked => { root.editing = true; }

            Text {
                text: root.display-value + root.suffix;
                color: #888;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        if root.editing: HorizontalLayout {
            spacing: 3px;
            edit-field := NumEdit {
                text: root.display-value;
                width: 56px;
                num-font-size: 11px;
                accepted => { root.commit-edit(self.text); }
                escaped => { root.editing = false; }
                changed has-focus => {
                    if !self.has-focus && root.editing {
                        root.commit-edit(self.text);
                    }
                }
            }
            Text { text: root.suffix; color: #888; font-size: 11px; vertical-alignment: center; }
            // Single-shot, fires once the branch-swap layout pass has
            // settled (see the doc comment above `LabeledSlider`).
            focus-timer := Timer {
                interval: 1ms;
                running: true;
                triggered => {
                    self.running = false;
                    edit-field.focus();
                    edit-field.select-all();
                }
            }
        }

        if root.step > 0: VerticalLayout {
            spacing: 1px;
            stepper-up := TouchArea {
                width: 14px;
                height: 9px;
                mouse-cursor: pointer;
                clicked => {
                    root.value = clamp(root.value + root.step, root.minimum, root.maximum);
                    root.changed(root.value);
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: stepper-up.has-hover ? #3a3a3a : transparent;
                    border-radius: 2px;
                    Text {
                        text: "▲";
                        font-size: 7px;
                        color: #888;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
            stepper-down := TouchArea {
                width: 14px;
                height: 9px;
                mouse-cursor: pointer;
                clicked => {
                    root.value = clamp(root.value - root.step, root.minimum, root.maximum);
                    root.changed(root.value);
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: stepper-down.has-hover ? #3a3a3a : transparent;
                    border-radius: 2px;
                    Text {
                        text: "▼";
                        font-size: 7px;
                        color: #888;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
}

/// Lookahead slider with VRAM risk colouring. Green/yellow/red zones show
/// where the chosen lookahead stops fitting GPU memory for the loaded source
/// resolution, so the user sees the risk and stays in control instead of
/// meeting a silent clamp or a post-hoc export failure. Thresholds (in the
/// same units as `value`) come from the engine's VRAM fit estimate; when
/// they are unknown the track falls back to a neutral colour.
component VramRiskSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> tip: "";
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    in property <string> suffix: "";
    in property <float> green-max;
    in property <float> red-min;
    in property <bool> risk-active: false;
    callback changed(float);

    spacing: 3px;

    function apply-x(mx: length, w: length) {
        root.value = clamp(
            root.minimum + (mx / w) * (root.maximum - root.minimum),
            root.minimum, root.maximum);
        root.changed(root.value);
    }

    HorizontalLayout {
        spacing: 6px;
        Tip {
            tip: root.tip;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: #bbb;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        Text {
            text: !root.risk-active ? ""
                : root.value <= root.green-max ? "safe"
                : root.value <= root.red-min ? "tight" : "may fail";
            color: !root.risk-active ? #888
                : root.value <= root.green-max ? #5cd65c
                : root.value <= root.red-min ? #e6c14d : #e35c5c;
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            text: round(root.value * 10) / 10 + root.suffix;
            color: #888;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    track := Rectangle {
        height: 16px;
        border-radius: 8px;
        clip: true;
        background: #2b2b2b;
        property <float> gfrac: clamp(root.green-max / max(root.maximum, 0.0001), 0.0, 1.0);
        property <float> rfrac: clamp(root.red-min / max(root.maximum, 0.0001), 0.0, 1.0);

        if root.risk-active: Rectangle {
            x: 0;
            y: 0;
            height: track.height;
            width: track.width * track.gfrac;
            background: #2e7d32;
        }
        if root.risk-active: Rectangle {
            x: track.width * track.gfrac;
            y: 0;
            height: track.height;
            width: max(0px, track.width * (track.rfrac - track.gfrac));
            background: #b8932a;
        }
        if root.risk-active: Rectangle {
            x: track.width * track.rfrac;
            y: 0;
            height: track.height;
            width: max(0px, track.width * (1.0 - track.rfrac));
            background: #b13b2e;
        }

        handle := Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: #ffffff;
            border-width: 2px;
            border-color: #222;
            y: (track.height - self.height) / 2;
            x: clamp((root.value - root.minimum) / max(root.maximum - root.minimum, 0.0001), 0.0, 1.0)
                * (track.width - self.width);
        }

        TouchArea {
            mouse-cursor: pointer;
            moved => {
                if (self.pressed) {
                    root.apply-x(self.mouse-x, track.width);
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.apply-x(self.mouse-x, track.width);
                }
            }
        }
    }

    if root.risk-active: Text {
        text: "fits ≈ " + (round(root.red-min * 10) / 10) + "s here (VRAM)";
        color: #777;
        font-size: 10px;
    }
}

/// Collapsible section header with clear hover feedback.
component SectionHeader inherits Rectangle {
    in property <string> title;
    in-out property <bool> expanded: false;

    height: 34px;
    border-radius: 8px;
    background: root.expanded ? #191d21 : section-touch.has-hover ? #24282c : transparent;
    border-width: 1px;
    border-color: root.expanded ? #2a2e33 : transparent;

    section-touch := TouchArea {
        clicked => { root.expanded = !root.expanded; }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        // Expanded/collapsed state marker: filled yellow when open, so an
        // open panel is unmistakable even from a glance across the whole
        // stack of section headers.
        Rectangle {
            width: 9px;
            height: 9px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: root.expanded ? #e5b84b : transparent;
            border-width: 1px;
            border-color: root.expanded ? #e5b84b : #454b52;
        }
        Text {
            text: root.title;
            color: #dcdfe3;
            font-size: 12.5px;
            font-weight: 550;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Chevron: points right when collapsed, down when open.
        Text {
            text: root.expanded ? "⌄" : "›";
            color: root.expanded ? #9aa0a7 : #6a7077;
            font-size: root.expanded ? 13px : 15px;
            vertical-alignment: center;
        }
    }
}

/// Bordered card grouping related calibration sliders under a small-caps
/// title, so a long flat list (Calibration panel) reads as distinct
/// sections at a glance instead of one undifferentiated column.
component CalGroupBox inherits Rectangle {
    in property <string> title;

    border-radius: 10px;
    border-width: 1px;
    border-color: #2a2e33;
    background: #16191c;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Text {
            text: root.title;
            color: #7a8087;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.6px;
        }

        @children
    }
}

/// Small flat transport button (jump/step/play/stop icons). The default
/// `Button` widget from std-widgets renders noticeably bulkier than this
/// - fine for the toolbar's full-size buttons, but too heavy for a tight
/// 6-up icon cluster under the timeline.
component TransportButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // The play/pause button in the cluster is emphasized (accent-tinted,
    // slightly wider) so the primary transport action reads at a glance.
    in property <bool> emphasized: false;
    callback clicked();

    width: root.emphasized ? 34px : 28px;
    height: 24px;
    border-radius: 6px;
    background: !root.enabled ? #1c1f22
        : root.emphasized
            ? (touch.has-hover ? #2c4a56 : #263842)
            : (touch.pressed ? #1f2226 : touch.has-hover ? #2e333a : #24282c);
    border-width: 1px;
    border-color: !root.enabled ? #2a2e33 : root.emphasized ? #33505e : #34393f;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: !root.enabled ? #565b61 : root.emphasized ? #6fd0fa : #d8d8d8;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

/// Flat action button, the app-wide replacement for std-widgets `Button`.
/// One consistent control language across the toolbar and panels: fixed
/// 28px height, 7px radius, flat control fill with a hover lighten. The
/// `primary` variant (blue) is used for the single dominant action in a
/// context (Export, Save, an active toggle). Auto-sizes to its label; put
/// it in a layout with `horizontal-stretch: 1` or set `width` to override.
component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();

    height: 28px;
    border-radius: 7px;
    border-width: 1px;

    property <color> base: root.primary ? #2f7bd6 : #24282c;
    property <color> hover: root.primary ? #3d89e2 : #2e333a;
    background: !root.enabled ? #1c1f22
        : touch.pressed ? (root.primary ? #2a6fc2 : #1f2226)
        : touch.has-hover ? hover
        : base;
    border-color: !root.enabled ? #2a2e33 : root.primary ? #2f7bd6 : #34393f;

    min-width: label.min-width;
    preferred-width: label.preferred-width;

    label := HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        Text {
            text: root.text;
            color: !root.enabled ? #565b61 : root.primary ? #ffffff : #dcdfe3;
            font-size: 12px;
            font-weight: root.primary ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Toast notification payload. Kept flat (no nested structs) so the
// Rust side can push via the generated `VecModel<Toast>` without
// wrapping ceremony. `id` is an opaque Rust-side counter used as the
// dismissal handle; UI code doesn't interpret it.
export struct Toast {
    id: int,
    severity: string, // "info" | "warn" | "error"
    title: string,
    body: string,
}

// A time range excluded from the export (e.g. a halftime pause) - the
// UI-side mirror of `reco_io::cut_range::CutRange`. Rust owns the
// authoritative list (`AppState::cut_ranges`); the UI only ever reads
// `root.cut-ranges` and requests changes via the `cut-range-*`
// callbacks below - it never mutates the array in place, since a drag
// in progress only updates a per-band local preview until release.
export struct CutRangeItem {
    start-secs: float,
    end-secs: float,
}

/// A single dismissible toast card. Stacked vertically by `ToastStack`.
///
/// Severity drives the left-border accent color:
/// - info: blue-grey
/// - warn: amber
/// - error: red
/// All three share the same dark card background to match the app chrome.
component ToastCard inherits Rectangle {
    in property <Toast> toast;
    callback dismissed(int);

    height: content.preferred-height + 16px;
    width: 360px;
    border-radius: 6px;
    background: #1f1f1f;
    border-width: 1px;
    border-color: #333;
    // Severity accent via left-edge bar (drawn with a clipped child
    // rectangle below). Also shifts the main border color subtly.
    drop-shadow-blur: 6px;
    drop-shadow-color: #000000aa;

    Rectangle {
        x: 0; y: 0;
        width: 4px;
        height: parent.height;
        background: root.toast.severity == "error" ? #e06060
                  : root.toast.severity == "warn"  ? #e0c060
                  : #6080c0;
    }

    content := HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.toast.title;
                color: #fff;
                font-size: 12px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.toast.body != "": Text {
                text: root.toast.body;
                color: #bbb;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        // Dismiss button. Kept narrow so the card body gets the space.
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: dismiss-touch.has-hover ? #3a3a3a : transparent;
            Text {
                text: "×";
                color: #888;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            dismiss-touch := TouchArea {
                clicked => { root.dismissed(root.toast.id); }
            }
        }
    }
}

/// Bottom-right stack of toast cards. Spawns a `ToastCard` per entry
/// in `toasts` and forwards dismissal back to the consumer via the
/// `dismissed(id)` callback.
component ToastStack inherits Rectangle {
    in property <[Toast]> toasts;
    in property <length> right-inset: 0px;
    callback dismissed(int);

    width: 100%;
    height: 100%;

    VerticalLayout {
        x: parent.width - self.preferred-width - 16px - root.right-inset;
        y: parent.height - self.preferred-height - 16px;
        spacing: 8px;
        alignment: end;

        for toast in root.toasts: ToastCard {
            toast: toast;
            dismissed(id) => { root.dismissed(id); }
        }
    }
}

// Per-side video segment list with drag-to-reorder (grip handle) and
// per-row removal. Rows are a fixed height so pointer travel maps cleanly
// to row offsets; the dragged row dims and the destination row is outlined
// to preview where the segment will land.
component SegmentList inherits Rectangle {
    in property <[string]> segments;
    in property <brush> card-bg;
    callback remove(int);
    callback reorder(int /* from */, int /* to */);

    property <int> drag-from: -1; // row being dragged, or -1 when idle
    property <int> drag-to: -1; // insertion gap [0..count] under the cursor
    property <length> row-h: 32px;
    property <length> row-gap: 5px;
    property <length> rowstep: root.row-h + root.row-gap;
    property <int> count: root.segments.length;

    height: root.count > 0 ? root.count * root.rowstep - root.row-gap : 0px;

    VerticalLayout {
        spacing: root.row-gap;
        for seg[idx] in root.segments: Rectangle {
            height: root.row-h;
            border-radius: 7px;
            background: root.card-bg;
            border-width: 1px;
            border-color: #34393f;
            // The dragged row dims to a "ghost"; the drop position is shown
            // by the insertion line below, not a per-row outline.
            opacity: root.drag-from == idx ? 0.4 : 1.0;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 6px;
                spacing: 6px;
                // Drag handle. Only active with 2+ segments to reorder.
                Rectangle {
                    width: 18px;
                    Text {
                        text: "⠿";
                        color: grip.has-hover || root.drag-from == idx ? #74d69a : #474c52;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    grip := TouchArea {
                        enabled: root.count > 1;
                        mouse-cursor: grab;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.drag-from = idx;
                                root.drag-to = idx;
                            }
                            if (e.kind == PointerEventKind.up) {
                                // drag-to is an insertion gap [0..count]. Dropping
                                // in either gap touching the source is a no-op;
                                // otherwise map the gap to a row index, adjusting
                                // for the source being removed first.
                                if (root.drag-from != -1
                                    && root.drag-to != root.drag-from
                                    && root.drag-to != root.drag-from + 1) {
                                    root.reorder(
                                        root.drag-from,
                                        root.drag-to > root.drag-from ? root.drag-to - 1 : root.drag-to);
                                }
                                root.drag-from = -1;
                                root.drag-to = -1;
                            }
                            if (e.kind == PointerEventKind.cancel) {
                                root.drag-from = -1;
                                root.drag-to = -1;
                            }
                        }
                        moved => {
                            if (root.drag-from == idx) {
                                // Nearest insertion gap to the cursor, in list
                                // coordinates (the grabbed grip reports mouse-y
                                // relative to its own row even past its bounds).
                                root.drag-to = Math.max(0, Math.min(root.count,
                                    Math.round((idx * root.rowstep + self.mouse-y) / root.rowstep)));
                            }
                        }
                    }
                }
                Text {
                    text: (idx + 1) + ". " + seg;
                    color: #dcdfe3;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: rm.has-hover ? #331516 : transparent;
                    Text { text: "×"; color: rm.has-hover ? #ff6b6b : #6a7077; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    rm := TouchArea { clicked => { root.remove(idx); } }
                }
            }
        }
    }

    // Insertion line: during a drag, drawn in the gap where the segment will
    // land - a thin accent bar with a dot on the leading edge. Hidden when the
    // target gap touches the dragged row (those drops are no-ops).
    if root.drag-from != -1 && root.drag-to != root.drag-from && root.drag-to != root.drag-from + 1: Rectangle {
        x: 0;
        y: max(0px, min(root.height - 2px, root.drag-to * root.rowstep - root.row-gap / 2));
        width: root.width;
        height: 2px;
        background: #74d69a;
        border-radius: 1px;
        Rectangle {
            x: 0px;
            y: -2px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #74d69a;
        }
    }
}

export component RecoApp inherits Window {
    title: "Reco Video Stitcher";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 600px;
    // Pin the UI font explicitly rather than relying on each renderer's
    // own generic "sans-serif" fallback resolution - femtovg-wgpu (via
    // fontdb) and Skia (via DirectWrite on Windows) can resolve that
    // fallback to fonts with different em-box/line-height metrics, which
    // read as an overall size change even though every `font-size` value
    // below is unchanged. Segoe UI is Windows' own system UI font.
    default-font-family: "Segoe UI";

    // ── Theme colors ──
    in-out property <bool> dark-mode: true;

    // Cool-biased dark neutrals (a hint of blue toward the cyan accent),
    // so the chrome reads as deliberately chosen rather than flat grey.
    property <color> bg-base: dark-mode ? #101214 : #f5f5f5;
    property <color> bg-panel: dark-mode ? #17191c : #eaeaea;
    property <color> bg-bar: dark-mode ? #1a1d20 : #e0e0e0;
    property <color> bg-surface: dark-mode ? #202327 : #fff;
    property <color> bg-card: dark-mode ? #202327 : #ddd;
    property <color> bg-hover: dark-mode ? #2e333a : #c8c8c8;
    property <color> bg-preview: dark-mode ? #0d0e10 : #444;
    property <color> bg-scrim: dark-mode ? #000000aa : #000000aa;
    property <color> border-subtle: dark-mode ? #2a2e33 : #ccc;
    property <color> border-mid: dark-mode ? #34393f : #aaa;
    property <color> text-primary: dark-mode ? #dcdfe3 : #111;
    property <color> text-body: dark-mode ? #c4c8cd : #222;
    property <color> text-secondary: dark-mode ? #9aa0a7 : #333;
    property <color> text-muted: dark-mode ? #777d84 : #444;
    property <color> text-dim: dark-mode ? #6a7077 : #555;
    property <color> text-faint: dark-mode ? #474c52 : #666;
    property <color> text-heading: dark-mode ? #f0f2f4 : #111;
    property <color> accent: dark-mode ? #74d69a : #2a7a2a;
    property <color> accent-info: dark-mode ? #8f8 : #2a8a2a;
    property <color> accent-warn: dark-mode ? #e8a060 : #c07020;
    property <color> accent-error: dark-mode ? #f88 : #c44;
    property <color> rec-bg: dark-mode ? #2a1a1a : #f0e0e0;
    property <color> rec-border: dark-mode ? #553333 : #c08080;
    property <color> rec-active-bg: dark-mode ? #4a1010 : #f0c0c0;
    property <color> rec-active-border: dark-mode ? #e04040 : #c03030;

    background: bg-base;

    // Preview area dimensions (Rust reads these to size the render target).
    out property <float> preview-area-width: preview-box.width / 1px;
    out property <float> preview-area-height: preview-box.height / 1px;

    // ── Properties bound from Rust ──

    in-out property <image> preview-frame;
    in-out property <bool> playing: false;
    in-out property <bool> files-loaded: false;
    in-out property <string> left-path: "";
    in-out property <string> right-path: "";
    in-out property <string> calibration-path: "";
    in-out property <string> status-text: "Load left + right videos and calibration JSON to begin";
    in-out property <float> progress: 0.0;
    in-out property <int> current-frame: 0;
    property <bool> frame-input-editing: false;
    in-out property <int> total-frames: 0;
    in-out property <string> current-time-text: "0:00";
    property <bool> speed-input-editing: false;
    // Playback speed multiplier, adjustable to frame accuracy (see
    // `Playback::set_speed`). 1.0 = normal speed.
    in-out property <float> playback-speed: 1.0;
    in-out property <string> total-time-text: "0:00";
    in-out property <float> fps: 0.0;
    in-out property <bool> calibrating: false;
    in-out property <bool> detecting-sync: false;
    // `audio-sync-expanded` mirrors the section's collapse state into
    // Rust so `maybe_recompute_audio_envelope` only runs the (relatively
    // expensive, ffmpeg-shelling) extraction while the user can see the
    // audio-sync waveform panel below.
    in-out property <bool> audio-sync-expanded: false;
    in-out property <[float]> audio-envelope-left: [];
    in-out property <[float]> audio-envelope-right: [];
    in-out property <float> audio-window-frames: 5.0;
    in-out property <float> audio-waveform-height-px: 300.0;
    in-out property <string> calibration-step: "";
    // Set once the background update-check thread finds a newer GitHub
    // release; drives the toolbar's "Update available" button instead of
    // auto-opening a browser tab (see `open-update-page` below).
    in-out property <bool> update-available: false;
    in-out property <string> update-tag: "";
    callback open-update-page();
    in-out property <bool> has-both-videos: left-path != "" && right-path != "";
    in-out property <bool> has-roi: false;
    in-out property <[float]> roi-points-x: [];
    in-out property <[float]> roi-points-y: [];
    callback paste-roi();
    in-out property <string> roi-manual-json: "";
    in-out property <[float]> goal-points-x: [];
    in-out property <[float]> goal-points-y: [];

    // Camera view state (kept in sync with Rust AppState).
    in-out property <float> yaw: 0.0;      // radians
    in-out property <float> pitch: 0.0;    // radians
    in-out property <float> fov: 75.0;     // degrees
    in-out property <float> blend-width: 0.05;
    in-out property <bool> blend-flip-direction: false;
    in-out property <bool> multiband-blend-enabled: false;
    in-out property <bool> show-seam-line: false;
    // Tracked via key-scope's key-pressed/key-released (see below) so the
    // preview drag handler can tell whether Shift is held during a mouse
    // drag - pointer-event's own modifiers aren't available in `moved`,
    // which has no event parameter.
    property <bool> shift-held: false;
    in-out property <float> seam-offset: 0.0;
    in-out property <bool> color-match-enabled: true;
    in-out property <float> color-match-band-width: 0.15;
    in-out property <float> color-match-grid-cols: 8;
    in-out property <float> color-match-grid-rows: 16;
    in-out property <float> color-match-interval-frames: 15;
    in-out property <float> color-match-ema-alpha: 0.15;
    in-out property <float> color-match-max-y-offset: 0.06;
    in-out property <float> color-match-max-chroma-offset: 0.04;
    // Live readout of the actual measured correction, refreshed every
    // rendered frame - see the Color Mapping section's diagnostic Text.
    in-out property <string> color-match-status: "";
    in-out property <float> rig-tilt: 0.0; // degrees
    in-out property <float> rig-roll: 0.0; // degrees
    in-out property <int> sync-offset: 0;  // frames

    // Live calibration adjustments (PlaneLayout fields on MatchCalibration).
    // Updating these re-runs StitchPipeline::update_layout() so the user
    // can fine-tune the stitch seam without re-running auto-calibrate.
    in-out property <float> cal-intersect: 0.0;
    in-out property <float> cal-camera-axis-offset: 0.0;
    in-out property <float> cal-x-ty: 0.0;
    in-out property <float> cal-x-rx: 0.0;
    in-out property <float> cal-z-rz: 0.0;
    in-out property <float> cal-ground-tilt-x: 0.0;
    in-out property <float> cal-ground-tilt-z: 0.0;
    in-out property <float> cal-top-tilt-x: 0.0;
    in-out property <float> cal-top-tilt-z: 0.0;
    in-out property <float> cal-ground-tilt-band-width: 0.16;
    in-out property <float> cal-top-tilt-band-width: 0.16;
    in-out property <bool> cal-dirty: false;  // true when user has edited

    // Side panel visibility (unified Controls + Stats).
    in-out property <bool> controls-open: false;

    // Export dialog state.
    in-out property <bool> export-dialog-open: false;
    in-out property <string> export-output-path: "";
    in-out property <int> export-width: 1920;
    in-out property <int> export-height: 1080;
    in-out property <string> export-codec: "h264";
    in-out property <[string]> available-codecs: ["h264", "hevc", "av1"];
    in-out property <string> export-quality: "balanced";
    in-out property <float> export-blend-width: 0.05;
    in-out property <float> export-start-secs: 0.0;
    in-out property <float> export-end-secs: 0.0;
    in-out property <float> clip-duration-secs: 0.0;
    // Time ranges excluded from the export (e.g. a halftime pause) -
    // see `CutRangeItem`. Rust is the source of truth; drag/edit/add/
    // remove all go through the callbacks below rather than mutating
    // this array from the UI.
    in-out property <[CutRangeItem]> cut-ranges: [];
    // Fired with the FINAL (start, end) once a drag on a cut-range
    // band (body move, or either edge resize) releases. Also used by
    // the numeric-field editors for direct entry. Rust validates
    // (ordering, overlap with other ranges) and pushes back a
    // corrected `cut-ranges` if the request wasn't clean.
    callback cut-range-update(int, float, float);
    // Appends a new cut range near the playhead (Rust picks a sensible
    // default width, clamped to the export window).
    callback cut-range-add();
    callback cut-range-remove(int);
    in-out property <string> export-model-path: "";
    in-out property <string> export-tracking-mode: "field";
    in-out property <int> export-detection-interval: 3;
    in-out property <float> export-player-anchor-rad: 0.20;
    // ~20 frames at 30fps - reco_autocam::trackers::ball::DEFAULT_COAST_FRAMES's
    // own equivalent (kept as the slider's own literal default, same
    // convention as export-player-anchor-rad above).
    in-out property <float> export-ball-coast-secs: 0.67;
    in-out property <bool> export-autocam-enabled: false;
    // Panner tuning (mapped onto FieldPannerConfig in export.rs). Defaults
    // mirror the validated football defaults; lookahead defaults on because
    // dead-zone assumes it is active to absorb its latency.
    in-out property <string> export-panner-preset: "broadcast";
    in-out property <float> export-lookahead-secs: 1.5;
    // Lookahead VRAM risk thresholds (seconds) for the export slider, set from
    // the engine's fit estimate once footage + GPU are known. green-max =
    // comfortable ceiling, red-min = hard ceiling that still fits VRAM.
    in-out property <float> lookahead-green-max: 0;
    in-out property <float> lookahead-red-min: 0;
    in-out property <bool> lookahead-risk-active: false;
    // Downconvert the lookahead pool to 8-bit before buffering, roughly
    // halving its VRAM cost for 10-bit sources (no effect on 8-bit
    // sources) at some cost to gradient smoothness in the final render -
    // the buffered frames feed both AI tracking and the stitch render.
    // Off by default.
    in-out property <bool> export-lookahead-reduced-bit-depth: false;
    // Run the detector's inference call on a dedicated background
    // thread instead of blocking the decode/stitch/encode loop (see
    // reco-core's `async_detect` module). Only affects the buffered/
    // export loop (lookahead > 0). Builds a second, separate detector
    // instance - a real but modest VRAM cost (~400MB / ~8% on the
    // reference machine's 8GB card, not a doubling of the whole
    // session), for a measured ~1.2-1.4x export speedup (see
    // docs/async-detect-benchmark-v054.md). Off by default: opt in on
    // cards with VRAM headroom to spare.
    in-out property <bool> export-async-detect: false;
    in-out property <string> export-framing: "action";
    in-out property <bool> export-lock-pitch: false;
    in-out property <string> export-cluster-mode: "density";
    in-out property <float> export-cluster-bandwidth: 0.30;
    in-out property <float> export-dead-zone: 0.20;
    in-out property <float> export-ball-weight: 0.20;
    in-out property <float> export-ball-max-dist-from-cluster: 0.5;
    in-out property <float> export-fov-tight: 22.0;
    in-out property <float> export-fov-wide: 58.0;
    in-out property <float> export-fov-default: 40.0;
    in-out property <float> export-fov-alpha: 0.01;
    in-out property <float> export-cluster-alpha: 0.012;
    in-out property <bool> export-replay-enabled: false;
    in-out property <bool> export-events-enabled: false;

    // Fires once per AI Tracking / panner slider edit above, so Rust can
    // persist the new value as the app-level last-used default (see
    // `GuiSettings::autocam_defaults` / `crate::settings`) without
    // requiring an explicit Save calibration click. Deliberately not
    // wired for `export-model-path` (already has its own dedicated
    // persistence in `on_pick_export_model`) or the progress/status
    // fields below (not tuning parameters).
    callback autocam-settings-changed();
    changed export-tracking-mode => { root.autocam-settings-changed(); }
    changed export-detection-interval => { root.autocam-settings-changed(); }
    changed export-player-anchor-rad => { root.autocam-settings-changed(); }
    changed export-ball-coast-secs => { root.autocam-settings-changed(); }
    changed export-panner-preset => { root.autocam-settings-changed(); }
    changed export-lookahead-secs => { root.autocam-settings-changed(); }
    changed export-lookahead-reduced-bit-depth => { root.autocam-settings-changed(); }
    changed export-async-detect => { root.autocam-settings-changed(); }
    changed export-framing => { root.autocam-settings-changed(); }
    changed export-lock-pitch => { root.autocam-settings-changed(); }
    changed export-cluster-mode => { root.autocam-settings-changed(); }
    changed export-cluster-bandwidth => { root.autocam-settings-changed(); }
    changed export-dead-zone => { root.autocam-settings-changed(); }
    changed export-ball-weight => { root.autocam-settings-changed(); }
    changed export-ball-max-dist-from-cluster => { root.autocam-settings-changed(); }
    changed export-fov-tight => { root.autocam-settings-changed(); }
    changed export-fov-wide => { root.autocam-settings-changed(); }
    changed export-fov-default => { root.autocam-settings-changed(); }
    changed export-fov-alpha => { root.autocam-settings-changed(); }
    changed export-cluster-alpha => { root.autocam-settings-changed(); }

    // Export progress (also used by the main status bar).
    in-out property <bool> export-in-progress: false;
    in-out property <float> export-progress: 0.0; // 0..1
    in-out property <int> export-frames-done: 0;
    in-out property <int> export-frames-total: 0;
    in-out property <string> export-status-text: "";
    in-out property <string> export-error-text: "";

    // Compile-time AI capability summary. Seeded by Rust at startup
    // so the user can tell at-a-glance whether ball tracking will
    // actually work with their build (TensorRT, CUDA, CoreML, etc).
    in-out property <string> ai-status: "AI: unknown";
    in-out property <bool> ai-available: false;

    in-out property <string> version: "";
    in-out property <string> last-output-path: "";

    // Lens profile info. Populated after auto-calibration so the user
    // can see which lens the detector resolved to. Empty strings render
    // as "Unknown" via the Lens card below; `lens-info-available` flips
    // when there's anything worth showing.
    in-out property <string> lens-left-camera: "";
    in-out property <string> lens-left-lens: "";
    in-out property <string> lens-left-source: "";
    in-out property <string> lens-right-camera: "";
    in-out property <string> lens-right-lens: "";
    in-out property <string> lens-right-source: "";
    in-out property <int> lens-candidates-count: 0;
    in-out property <bool> lens-info-available: false;

    // Opt-in use of IMU-derived camera orientation as initial seeds
    // for the bundle-adjustment optimizer. Helpful on clips whose first
    // frame is pointed off-axis; harmful if the IMU is noisy. Default
    // off because the feature-matching seed is reliable on most footage.
    in-out property <bool> use-imu-seeds: false;
    // Forces the optimizer to solve the right camera's independent pitch
    // (x_rx) even without IMU data. Normally x_rx only turns on when the
    // IMU sees >2 deg differential pitch between cameras; rigs without a
    // native gyro never get that seed. Off by default: one more free
    // rotation axis for the optimizer to fit against matched points risks
    // overfitting noise instead of the real rotation.
    in-out property <bool> force-x-rx: false;
    // Forces the optimizer to solve the left camera's independent roll
    // (z_rz). Unlike x_rx there is no IMU signal to auto-detect this and
    // no auto-enable gate to bypass - it's always off unless checked here.
    in-out property <bool> force-z-rz: false;
    // Feature detection normally downscales frames wider than 1920px for
    // speed (keypoints are mapped back to full resolution afterward).
    // Enabling this detects at full source resolution instead - slower,
    // but can improve precision on 4K+ footage.
    in-out property <bool> cal-full-res-features: false;
    in-out property <int> calibration-frames: 4;
    in-out property <float> cal-akaze-threshold: 0.0001;
    in-out property <float> cal-detect-y-min: 0.05;
    in-out property <float> cal-detect-y-max: 0.95;
    in-out property <float> cal-skip-end-secs: 0.0;

    // When true (default), pan/zoom is clamped to the coverage boundary
    // so the viewport never shows black margins. Users can disable it
    // to inspect what is happening beyond the stitched region, which is
    // useful for calibration debug.
    in-out property <bool> use-constrained-look: true;

    // Recent-files dialog state.
    in-out property <bool> recent-dialog-open: false;
    in-out property <[string]> recent-left-paths: [];
    in-out property <[string]> recent-right-paths: [];
    in-out property <[string]> recent-calibration-paths: [];

    // Keyboard shortcut help modal.
    in-out property <bool> shortcuts-dialog-open: false;

    // Debug panel: live tail of the app's tracing log, refreshed
    // periodically from Rust (see `debug_log_snapshot` in main.rs) -
    // release builds have no visible console
    // (`windows_subsystem = "windows"`), so this is the only way a user
    // can see log output without digging up the log file for a bug
    // report. Shown in its own floating `DebugWindow` (see bottom of
    // this file) rather than an in-window modal, so it can sit beside
    // the main window instead of covering it.
    callback open-debug-window();

    // Preferences dialog state.
    in-out property <bool> prefs-dialog-open: false;
    in-out property <string> prefs-default-codec: "h264";
    in-out property <string> prefs-default-quality: "balanced";
    in-out property <float> prefs-default-blend-width: 0.05;
    in-out property <string> prefs-ai-model-path: "";
    in-out property <string> prefs-default-calibration-path: "";

    // Toast notification list (Tier 3a).
    in-out property <[Toast]> toasts: [];
    callback toast-dismissed(int);

    // Telemetry panel state.
    in-out property <bool> stats-panel-open: false;
    in-out property <float> telem-fps-avg: 0.0;
    in-out property <float> telem-fps-recent: 0.0;
    in-out property <float> telem-decode-ms: 0.0;
    in-out property <float> telem-stitch-ms: 0.0;
    in-out property <float> telem-readback-ms: 0.0;
    in-out property <float> telem-submit-ms: 0.0;
    in-out property <float> telem-total-ms: 0.0;
    in-out property <float> telem-p99-ms: 0.0;
    in-out property <float> telem-detection-ms: 0.0;
    in-out property <int> telem-active-tracks: 0;
    in-out property <float> telem-ball-pct: 0.0;
    in-out property <float> telem-det-per-frame: 0.0;
    in-out property <int> telem-frames-dropped: 0;
    in-out property <string> telem-gpu-name: "";
    in-out property <string> telem-bottleneck: "";
    in-out property <float> telem-cal-confidence: 0.0;
    in-out property <float> telem-cal-reproj-err: 0.0;
    in-out property <int> telem-cal-matches: 0;

    // Per-camera lens intrinsics (populated by Rust after auto-calibrate
    // from `CalibrationResult.left_lens_profile` / `right_lens_profile`).
    // The Lens tab binds sliders to these properties; changes flow back
    // to Rust via `changed-lens-param`, which calls
    // `StitchRenderer::update_camera_params` for live preview.
    in-out property <float> lens-left-fx: 0.0;
    in-out property <float> lens-left-fy: 0.0;
    in-out property <float> lens-left-cx: 0.0;
    in-out property <float> lens-left-cy: 0.0;
    in-out property <float> lens-left-k1: 0.0;
    in-out property <float> lens-left-k2: 0.0;
    in-out property <float> lens-left-k3: 0.0;
    in-out property <float> lens-left-k4: 0.0;
    in-out property <float> lens-right-fx: 0.0;
    in-out property <float> lens-right-fy: 0.0;
    in-out property <float> lens-right-cx: 0.0;
    in-out property <float> lens-right-cy: 0.0;
    in-out property <float> lens-right-k1: 0.0;
    in-out property <float> lens-right-k2: 0.0;
    in-out property <float> lens-right-k3: 0.0;
    in-out property <float> lens-right-k4: 0.0;
    // Slider display ranges (set by Rust to baseline +/- safe delta).
    in-out property <float> lens-fx-min: 0.0;
    in-out property <float> lens-fx-max: 0.0;
    in-out property <float> lens-fy-min: 0.0;
    in-out property <float> lens-fy-max: 0.0;
    in-out property <float> lens-cx-min: 0.0;
    in-out property <float> lens-cx-max: 0.0;
    in-out property <float> lens-cy-min: 0.0;
    in-out property <float> lens-cy-max: 0.0;
    in-out property <float> lens-k-range: 0.3; // k sliders: baseline +/- this
    in-out property <bool> lens-dirty: false;
    // Which camera the lens-tab sliders are editing.
    in-out property <string> lens-selected-camera: "left";

    // ── Callbacks into Rust ──

    callback pick-left-video();
    callback pick-right-video();
    callback pick-calibration();
    callback auto-calibrate();
    // Fired whenever an AKAZE tuning slider/checkbox changes, so Rust can
    // re-run detection on the current frame and show the result live
    // without a full Auto-Calibrate run.
    callback detect-preview-tick();
    callback toggle-playback();
    callback pause-playback();
    callback step-forward();
    callback step-backward();
    callback seek(float);
    // Relative seek in seconds (negative for rewind). CLI parity with `[` and `]`.
    callback seek-relative(float);
    callback changed-playback-speed(float);
    // Mouse drag delta in pixels.
    callback pan(float, float);
    // Scroll wheel delta (degrees FOV per tick).
    callback zoom(float);
    // Reset yaw/pitch/fov to defaults.
    callback reset-view();
    // Settings-panel slider callbacks.
    callback changed-blend-width(float);
    callback changed-blend-flip-direction(bool);
    callback changed-multiband-blend-enabled(bool);
    callback changed-show-seam-line(bool);
    callback changed-seam-offset(float);
    // Fired while dragging the preview with Show seam line active. `dx` is
    // the horizontal drag delta normalized by preview width (dimensionless
    // - not pixels), so sensitivity doesn't change with window/panel size.
    callback seam-drag(float);
    // Hit-test against the seam debug line's actual on-screen projection
    // (uses the live camera yaw/pitch, so it tracks correctly under
    // pan/tilt, not just when centered). Args: (mouse-x, mouse-y,
    // preview-box.width, preview-box.height), all in raw box-relative
    // pixels - NOT the `local-x`/`local-y`/`content-w`/`content-h`
    // convention `roi-pointer-hit-test` uses, which is specific to
    // lens-preview mode's own letterbox math (unused/meaningless outside
    // it). Rust reconstructs the real (non-lens) letterbox itself from the
    // output aspect ratio.
    callback seam-hit-test(float, float, float, float) -> bool;
    callback changed-color-match-enabled(bool);
    callback changed-color-match-band-width(float);
    callback changed-color-match-grid-cols(float);
    callback changed-color-match-grid-rows(float);
    callback changed-color-match-interval-frames(float);
    callback changed-color-match-ema-alpha(float);
    callback changed-color-match-max-y-offset(float);
    callback changed-color-match-max-chroma-offset(float);
    callback remeasure-color-match();
    callback reset-color-match();
    callback changed-rig-tilt(float);
    callback changed-rig-roll(float);
    callback changed-sync-offset(int);
    callback compute-sync-offset();
    callback changed-audio-window-frames(float);
    callback changed-fov(float);
    // Live calibration editing.
    callback changed-cal-intersect(float);
    callback changed-cal-camera-axis-offset(float);
    callback changed-cal-x-ty(float);
    callback changed-cal-x-rx(float);
    callback changed-cal-z-rz(float);
    callback changed-cal-ground-tilt-x(float);
    callback changed-cal-ground-tilt-z(float);
    callback changed-cal-top-tilt-x(float);
    callback changed-cal-top-tilt-z(float);
    callback changed-cal-ground-tilt-band-width(float);
    callback changed-cal-top-tilt-band-width(float);
    callback save-calibration();
    callback reset-calibration();
    // Live lens parameter editing. Fires on any of the 8 sliders per
    // camera; Rust reads the property values for the currently-selected
    // camera and calls update_camera_params.
    callback changed-lens-param();
    callback reset-lens();

    // Lens picker dialog.
    callback lens-search-changed(string);
    callback lens-pick(int, string);
    callback lens-pick-file();
    in-out property <bool> lens-picker-open: false;
    in-out property <string> lens-search-query: "";
    in-out property <[string]> lens-search-results: [];
    in-out property <string> lens-pick-side: "both";

    // Lens preview mode (single-camera flat view).
    in-out property <bool> lens-preview-active: false;
    in-out property <string> lens-preview-side: "left";
    in-out property <float> lens-correction-amount: 1.0;
    callback changed-lens-preview();
    callback changed-lens-correction(float);

    // Lens-preview pan/zoom - pure view state, never touches Rust (the
    // texture is already rendered at full native camera resolution, so
    // zoom/pan is just a scale+translate of the displayed Image).
    // `lens-frame-aspect` is the exception: Rust sets it (native camera
    // width/height) since Slint has no access to the decoded video's
    // dimensions otherwise.
    in-out property <float> lens-frame-aspect: 1.0;
    property <float> lens-zoom: 1.0;
    property <length> lens-pan-x: 0px;
    property <length> lens-pan-y: 0px;
    // In-app field-ROI / goal-geometry point editor (click to add, drag to
    // move, right-click to delete), replacing the old browser-based tool.
    // One shared session (`zone-edit-mode`) for both polygon types - both
    // live in the same per-camera distorted lens-preview window (ROI and
    // GOAL points are both raw-distorted-frame-normalized `[0,1]`, see
    // `GoalGeometry`'s doc for why), so there is nothing type-specific
    // about *entering* the session, only about which callbacks/overlay a
    // click currently drives - that's `zone-edit-type`.
    in-out property <bool> zone-edit-mode: false;
    // Whether entering the session auto-enabled lens preview (it was off
    // before); if so, leaving the session turns it back off too,
    // returning to the stitched panorama view. Left alone if the user was
    // already in lens preview for their own reasons.
    property <bool> zone-edit-auto-lens-preview: false;
    // Which polygon type the session's click/drag/right-click gestures
    // currently apply to - "roi" or "goal". Also determines which status
    // text/help text/toggle button is highlighted even while no session
    // is active, so it stays put across a Done-then-Edit cycle.
    in-out property <string> zone-edit-type: "roi";
    in-out property <string> roi-path-commands: "";
    callback roi-pointer-hit-test(float, float, float, float) -> int;
    callback roi-pointer-add(float, float, float, float);
    callback roi-pointer-drag(int, float, float, float, float);
    callback roi-pointer-up();
    callback roi-pointer-delete(float, float, float, float);
    in-out property <bool> has-goal-geometry: false;
    in-out property <string> goal-path-commands: "";
    callback goal-pointer-hit-test(float, float, float, float) -> int;
    callback goal-pointer-add(float, float, float, float);
    callback goal-pointer-drag(int, float, float, float, float);
    callback goal-pointer-up();
    callback goal-pointer-delete(float, float, float, float);

    // Shared enter/exit logic, used by the DETECTION ZONES card's single
    // Edit/Done button below.
    function enter-zone-edit() {
        if (!root.lens-preview-active) {
            root.lens-preview-active = true;
            root.zone-edit-auto-lens-preview = true;
            root.changed-lens-preview();
        } else {
            root.zone-edit-auto-lens-preview = false;
        }
        root.zone-edit-mode = true;
    }
    function exit-zone-edit() {
        root.zone-edit-mode = false;
        if (root.zone-edit-auto-lens-preview) {
            root.zone-edit-auto-lens-preview = false;
            root.lens-preview-active = false;
            root.changed-lens-preview();
        }
    }

    changed lens-preview-side => {
        root.lens-zoom = 1.0;
        root.lens-pan-x = 0px;
        root.lens-pan-y = 0px;
    }
    changed lens-preview-active => {
        root.lens-zoom = 1.0;
        root.lens-pan-x = 0px;
        root.lens-pan-y = 0px;
        if (!root.lens-preview-active) {
            root.zone-edit-mode = false;
        }
    }

    // Constrained-look checkbox. Fires when the user toggles it so Rust
    // can sync `AppState.use_constrained_look` with the UI property
    // (Slint's <=> binding updates the property but Rust needs a notify
    // to act on the new value).
    callback changed-constrained-look();
    // Recent-files modal: load a specific path into one of the three
    // file slots. Same effect as picking it from the native dialog.
    callback load-recent-left(string);
    callback load-recent-right(string);
    callback load-recent-calibration(string);
    callback clear-recent-files();
    // Preferences dialog: open prefills from user_settings, save
    // writes back (Rust handles persistence), pick-model opens a
    // file dialog for the AI model path.
    callback open-prefs-dialog();
    callback save-prefs();
    callback pick-prefs-model();
    callback pick-prefs-default-calibration();
    callback open-website();
    callback open-forum();
    in-out property <bool> prefs-telemetry-enabled: false;
    in-out property <bool> prefs-dark-mode: true;
    // Export dialog actions.
    callback open-export-dialog();
    callback pick-export-output();
    callback pick-export-model();
    callback start-export();
    // Populate the visible panner controls from a named preset.
    callback apply-panner-preset(string);
    callback cancel-export();
    callback submit-bug-report(string, string, bool);
    in-out property <bool> bug-dialog-open: false;
    // Confirmation shown when Start Export is clicked with no field ROI set -
    // export still works without one, but AI framing/tracking degrades badly,
    // so this catches the common "forgot to set it" mistake before a long
    // export runs to completion.
    in-out property <bool> no-roi-warning-open: false;
    // Confirmation shown when Save Calibration would overwrite whichever
    // file is configured as the preferences' Default Calibration - that
    // file is meant to be a stable fallback for future sessions, so
    // overwriting it in-place needs an explicit "yes really" rather than
    // silently changing what every session with no calibration falls
    // back to. Rust decides whether to open this (it knows both paths);
    // confirming calls `confirm-save-calibration` instead of
    // `save-calibration` to skip the check on the second click.
    in-out property <bool> overwrite-default-cal-warning-open: false;
    callback confirm-save-calibration();
    in-out property <string> bug-user-contact: "";
    callback show-in-folder(string);
    callback toggle-recording(string, string);
    callback pick-recording-folder();
    in-out property <bool> recording: false;
    in-out property <string> recording-quality: "balanced";
    in-out property <string> recording-codec: "h264";
    in-out property <string> recording-folder: "";

    // Preview aspect ratio mode: "auto" fills the available space
    // preserving the source aspect; ratio values constrain the
    // preview container to that shape.
    in-out property <string> preview-aspect: "auto";
    callback changed-preview-aspect(string);

    // File management: per-side segment lists and removal.
    in-out property <[string]> left-segments: [];
    in-out property <[string]> right-segments: [];
    callback remove-left-segment(int);
    callback remove-right-segment(int);
    callback reorder-left-segment(int /* from */, int /* to */);
    callback reorder-right-segment(int /* from */, int /* to */);
    callback clear-left();
    callback clear-right();
    callback clear-calibration();

    // Left panel (files) visibility.
    in-out property <bool> files-panel-open: false;
    // Panel widths (resizable via drag handles).
    in-out property <length> left-panel-width: 260px;
    // Wider than the left panel: this column holds LabeledSlider rows
    // whose up/down stepper arrows sit at the far right edge, right where
    // the ScrollView's vertical scrollbar renders - too narrow and the
    // scrollbar overlaps the steppers, making them unclickable.
    in-out property <length> right-panel-width: 320px;

    // Keyboard handling. The FocusScope must *wrap* the content so
    // key events have somewhere to bubble up when a child (button,
    // slider, text input) is focused. `init` grabs focus on startup
    // so shortcuts work before the user clicks anything. The
    // `refocus` callback lets Rust re-assert focus after any action
    // that a widget would otherwise steal it with.
    forward-focus: key-scope;
    public function refocus() { key-scope.focus(); }

    key-scope := FocusScope {
        // FocusScope doesn't fill its Window parent by default; the
        // VerticalBox below would render at its preferred height and
        // overflow the bottom of the window, hiding the transport
        // controls and status bar. Explicit 100/100 fixes that.
        width: 100%;
        height: 100%;
        init => {
            self.focus();
            Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        }
        key-pressed(event) => {
            // Space: play/pause
            if (event.text == " ") { root.toggle-playback(); return accept; }
            // Arrow keys: pan
            if (event.text == Key.LeftArrow)  { root.pan(-20, 0); return accept; }
            if (event.text == Key.RightArrow) { root.pan(20, 0);  return accept; }
            if (event.text == Key.UpArrow)    { root.pan(0, -20); return accept; }
            if (event.text == Key.DownArrow)  { root.pan(0, 20);  return accept; }
            // +/- : zoom
            if (event.text == "+" || event.text == "=") { root.zoom(-5); return accept; }
            if (event.text == "-" || event.text == "_") { root.zoom(5);  return accept; }
            // [ / ] : seek by 5s
            if (event.text == "[") { root.seek-relative(-5); return accept; }
            if (event.text == "]") { root.seek-relative(5);  return accept; }
            // R : reset view (or lens-preview zoom/pan, in that mode)
            if (event.text == "r" || event.text == "R") {
                if (root.lens-preview-active) {
                    root.lens-zoom = 1.0;
                    root.lens-pan-x = 0px;
                    root.lens-pan-y = 0px;
                } else {
                    root.reset-view();
                }
                return accept;
            }
            // F or F11 : toggle fullscreen
            if (event.text == "f" || event.text == "F" || event.text == Key.F11) {
                root.full-screen = !root.full-screen;
                return accept;
            }
            if (event.text == Key.Shift) {
                root.shift-held = true;
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Shift) {
                root.shift-held = false;
                return accept;
            }
            return reject;
        }

        // VerticalLayout (not VerticalBox) because VerticalBox applies
        // implicit outer padding that pushed the bottom transport/status
        // bars off the content area. Explicit layout with zero spacing
        // ensures the file-bar + preview + transport + status fit the
        // window exactly, no inset on any edge.
        VerticalLayout {
            spacing: 0;

        // ── Toolbar ──
        Rectangle {
            background: root.bg-bar;
            height: 42px;

            HorizontalBox {
                padding: 6px;
                spacing: 6px;
                alignment: start;

                FlatButton {
                    text: root.files-panel-open ? "◀ Files" : "Files ▶";
                    clicked => { root.files-panel-open = !root.files-panel-open; }
                }

                if root.calibrating: Text {
                    text: root.calibration-step;
                    color: #8888ff;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                FlatButton { text: "Debug"; clicked => { root.open-debug-window(); } }
                FlatButton { text: "?"; clicked => { root.shortcuts-dialog-open = true; } }
                FlatButton { text: "⚙"; clicked => { root.open-prefs-dialog(); } }

                // Sits between the FOV badge (centered over the preview,
                // to this button's left) and Export (to its right) - same
                // 42px toolbar band as both, so it reads as part of the
                // same row instead of a popup/toast. Only ever appears
                // once the background version check actually finds a
                // newer release; clicking opens the download page - no
                // more auto-opening a browser tab unasked (see
                // `open-update-page` / `update-available`'s doc comment).
                if root.update-available: FlatButton {
                    text: "Update available (" + root.update-tag + ")";
                    clicked => { root.open-update-page(); }
                }

                FlatButton {
                    text: "Export…";
                    enabled: root.files-loaded && !root.export-in-progress;
                    primary: true;
                    clicked => { root.open-export-dialog(); }
                }

            }

            // Right controls-panel toggle. Absolutely positioned (not a
            // HorizontalBox child like the other toolbar buttons) so its
            // right edge can be pinned to the boundary between the middle
            // (preview) column and the right panel - a `Rectangle{width:
            // right-panel-width}` spacer added after it inside the
            // HorizontalBox did not reserve space the way a fixed-size
            // layout child normally would once a second non-stretch
            // element competed with the existing `horizontal-stretch: 1`
            // spacer, so this sidesteps that entirely with direct
            // geometry instead of relying on the box layout's stretch math.
            // has-both-videos (not files-loaded): the right panel also
            // holds the auto-calibrate tuning knobs, reachable before the
            // first calibration exists.
            FlatButton {
                x: parent.width - (root.controls-open ? root.right-panel-width : 0px) - self.width - 6px;
                y: 7px;
                width: 110px;
                height: 28px;
                text: root.controls-open ? "◀ Expert Mode" : "Expert Mode ▶";
                enabled: root.has-both-videos;
                clicked => { root.controls-open = !root.controls-open; }
            }
        }

        // ── Left files panel + Preview + Right controls ──
        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            // ── Left files panel ──
            if root.files-panel-open: Rectangle {
                background: root.bg-panel;
                width: root.left-panel-width;

                // Resize handle on the right edge
                Rectangle {
                    x: parent.width - 4px;
                    width: 6px;
                    height: parent.height;
                    background: left-resize.has-hover || left-resize.pressed ? #555 : #333;

                    left-resize := TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            if (self.pressed) {
                                root.left-panel-width = max(180px, root.left-panel-width + (self.mouse-x - self.pressed-x));
                            }
                        }
                    }
                }

                ScrollView {
                    horizontal-scrollbar-policy: always-off;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        alignment: start;

                        // Left video section
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Left"; color: #8ae68a; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            FlatButton { text: "+"; clicked => { root.pick-left-video(); } }
                            FlatButton { text: "Clear"; enabled: root.left-path != ""; clicked => { root.clear-left(); } }
                        }

                        if root.left-segments.length == 0: Text {
                            text: "No video selected";
                            color: #666;
                            font-size: 11px;
                        }

                        SegmentList {
                            segments: root.left-segments;
                            card-bg: root.bg-card;
                            remove(i) => { root.remove-left-segment(i); }
                            reorder(f, t) => { root.reorder-left-segment(f, t); }
                        }

                        Rectangle { height: 1px; background: root.border-subtle; }

                        // Right video section
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Right"; color: #8ae68a; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            FlatButton { text: "+"; clicked => { root.pick-right-video(); } }
                            FlatButton { text: "Clear"; enabled: root.right-path != ""; clicked => { root.clear-right(); } }
                        }

                        if root.right-segments.length == 0: Text {
                            text: "No video selected";
                            color: #666;
                            font-size: 11px;
                        }

                        SegmentList {
                            segments: root.right-segments;
                            card-bg: root.bg-card;
                            remove(i) => { root.remove-right-segment(i); }
                            reorder(f, t) => { root.reorder-right-segment(f, t); }
                        }

                        if root.has-both-videos || root.calibration-path != "": Rectangle { height: 1px; background: root.border-subtle; }

                        if root.has-both-videos || root.calibration-path != "": Text { text: "Calibration"; color: #aaa; font-size: 12px; font-weight: 600; }

                        if root.has-both-videos: HorizontalLayout {
                            spacing: 4px;
                            FlatButton {
                                text: root.calibrating
                                    ? "Calibrating..."
                                    : (root.files-loaded ? "Re-calibrate" : "Auto Calibrate");
                                enabled: !root.calibrating;
                                horizontal-stretch: 1;
                                clicked => { root.auto-calibrate(); }
                            }
                            FlatButton {
                                text: "Load…";
                                clicked => { root.pick-calibration(); }
                            }
                        }

                        if root.calibration-path != "": Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: root.bg-card;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 4px;
                                spacing: 4px;
                                Text {
                                    text: root.calibration-path;
                                    color: #ccc;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 3px;
                                    background: cal-rm.has-hover ? #3a2020 : transparent;
                                    Text { text: "×"; color: #888; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                    cal-rm := TouchArea { clicked => { root.clear-calibration(); } }
                                }
                            }
                        }

                        // Stitching settings only appear after calibration is loaded
                        if root.files-loaded: Rectangle { height: 1px; background: root.border-subtle; }

                        if root.files-loaded: Text { text: "Stitching"; color: #aaa; font-size: 12px; font-weight: 600; }

                        if root.files-loaded: VerticalLayout {
                            spacing: 10px;

                            CalGroupBox {
                                title: "SEAM";

                                LabeledSlider {
                                    tip: "Width of the feathered blend at the seam between the two cameras.";
                                    label: "Seam blend";
                                    minimum: 0;
                                    maximum: 0.3;
                                    value <=> root.blend-width;
                                    decimals: 2;
                                    step: 0.01;
                                    changed(v) => { root.changed-blend-width(v); }
                                }

                                Tip {
                                    tip: "Which camera fades in over the other at the seam. Off (default): right fades over a fixed left. On: left fades over a fixed right. Doesn't move the seam itself.";
                                    CheckBox {
                                        text: "Flip blend direction (left over right)";
                                        checked <=> root.blend-flip-direction;
                                        toggled => { root.changed-blend-flip-direction(self.checked); }
                                    }
                                }

                                Tip {
                                    tip: "Spatial (multi-band) blend: blurs low frequencies over a wide band and keeps high frequencies over a narrow band, instead of a single crossfade. Lets the seam blend read as wider without doubling fine detail (ball, player edges, field lines) - but costs 10 render passes instead of 1. Experimental.";
                                    CheckBox {
                                        text: "Multi-band blend (experimental)";
                                        checked <=> root.multiband-blend-enabled;
                                        toggled => { root.changed-multiband-blend-enabled(self.checked); }
                                    }
                                }

                                Tip {
                                    tip: "Draws a thin red line at the exact geometric seam position, independent of how wide the seam blend is. Purely a visual aid for tuning Seam position and Flip blend direction - doesn't affect the render otherwise.";
                                    CheckBox {
                                        text: "Show seam line";
                                        checked <=> root.show-seam-line;
                                        toggled => { root.changed-show-seam-line(self.checked); }
                                    }
                                }

                                LabeledSlider {
                                    tip: "Moves the seam left/right by hand, independent of calibration - safe to drag freely, unlike Intersect (which can open a black gap if pushed too far). Or drag directly on the preview while Show seam line is on.";
                                    label: "Seam position";
                                    minimum: -0.3;
                                    maximum: 0.3;
                                    value <=> root.seam-offset;
                                    decimals: 3;
                                    step: 0.005;
                                    changed(v) => { root.changed-seam-offset(v); }
                                }
                            }

                            CalGroupBox {
                                title: "RIG ALIGNMENT";

                                LabeledSlider {
                                    tip: "Forward/backward lean of the camera rig; straightens vertical lines at the panorama edges.";
                                    label: "Rig tilt";
                                    minimum: -30;
                                    maximum: 30;
                                    value <=> root.rig-tilt;
                                    suffix: "°";
                                    decimals: 1;
                                    step: 0.1;
                                    changed(v) => { root.changed-rig-tilt(v); }
                                }

                                LabeledSlider {
                                    tip: "Side-to-side tilt of the camera rig.";
                                    label: "Rig roll";
                                    minimum: -15;
                                    maximum: 15;
                                    value <=> root.rig-roll;
                                    suffix: "°";
                                    decimals: 1;
                                    step: 0.1;
                                    changed(v) => { root.changed-rig-roll(v); }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "Sync offset"; color: #aaa; font-size: 11px; vertical-alignment: center; }
                                    sync-input := NumEdit {
                                        text: root.sync-offset;
                                        width: 70px;
                                        accepted => { root.sync-offset = self.text.to-float(); root.changed-sync-offset(self.text.to-float()); }
                                        escaped => { self.text = root.sync-offset; }
                                    }
                                    Text { text: "frames"; color: #777; font-size: 10px; vertical-alignment: center; }
                                    FlatButton { text: "Apply"; clicked => { root.sync-offset = sync-input.text.to-float(); root.changed-sync-offset(sync-input.text.to-float()); } }
                                }

                                Tip {
                                    tip: "Detect the sync offset only (IMU telemetry, falling back to audio cross-correlation) - the same detection Auto-Calibrate uses internally, without running feature matching/optimization. Can take up to a minute or two on footage with heavy IMU telemetry.";
                                    FlatButton {
                                        text: root.detecting-sync ? "Detecting…" : "Detect Sync Offset";
                                        enabled: !root.detecting-sync && !root.calibrating;
                                        clicked => { root.compute-sync-offset(); }
                                    }
                                }
                            }

                            if root.cal-dirty || root.lens-dirty: FlatButton {
                                text: "Save Calibration";
                                primary: true;
                                clicked => { root.save-calibration(); }
                            }

                            CalGroupBox {
                                title: "DETECTION ZONES";

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.has-roi ? "Field ROI: loaded" : "Field ROI: none";
                                        color: root.has-roi ? #8ae68a : #777;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.has-goal-geometry ? "Goal Geometry: loaded" : "Goal Geometry: none";
                                        color: root.has-goal-geometry ? #ffb066 : #777;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }

                                // Single entry point for both polygon types -
                                // opens the distorted lens preview, where a
                                // small ROI/GOAL toggle (top-left over the
                                // video, see the preview section below)
                                // picks which one the click/drag gestures
                                // apply to. `zone-edit-type` remembers the
                                // last choice across a Done-then-Edit cycle.
                                HorizontalLayout {
                                    spacing: 4px;
                                    FlatButton {
                                        text: root.zone-edit-mode ? "Done Editing" : "Edit ROI / GOAL...";
                                        primary: root.zone-edit-mode;
                                        horizontal-stretch: 1;
                                        clicked => {
                                            if (root.zone-edit-mode) { root.exit-zone-edit(); } else { root.enter-zone-edit(); }
                                        }
                                    }
                                    FlatButton {
                                        text: "Paste ROI";
                                        clicked => { root.paste-roi(); }
                                    }
                                }

                                LineEdit {
                                    placeholder-text: "Or paste ROI JSON here...";
                                    accepted(text) => {
                                        root.roi-manual-json = text;
                                        root.paste-roi();
                                    }
                                }

                                if root.zone-edit-mode && root.zone-edit-type == "roi": Text {
                                    text: "Click the lens preview to add points, drag a point to move it, right-click a point to delete it. Switch Left/Right above to edit the other camera.";
                                    color: root.text-dim;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }

                                if root.zone-edit-mode && root.zone-edit-type == "goal": Text {
                                    text: "Click the lens preview to add points, drag a point to move it, right-click a point to delete it. A goal needs 4+ points to bound both width and height. Switch Left/Right above to edit the other camera.";
                                    color: root.text-dim;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }

                                if !root.zone-edit-mode && !root.has-roi: Text {
                                    text: "Or paste ROI JSON above (from another calibration, or scripted).";
                                    color: root.text-dim;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: root.border-subtle; }

                        FlatButton {
                            text: "Recent…";
                            enabled: root.recent-left-paths.length > 0
                                   || root.recent-right-paths.length > 0
                                   || root.recent-calibration-paths.length > 0;
                            clicked => { root.recent-dialog-open = true; }
                        }
                    }
                }
            }

            // Preview (with mouse drag + scroll handling).
            // The outer Rectangle fills the layout cell; the inner
            // `preview-box` optionally constrains itself to a chosen
            // aspect ratio and centers inside the outer area.
            preview-column := Rectangle {
                background: root.bg-preview;
                horizontal-stretch: 1;

                if !root.files-loaded: VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: "Reco Video Stitcher";
                        color: #555;
                        font-size: 20px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "1. Open Files panel and add left + right videos\n2. Auto Calibrate or load a calibration JSON\n3. Preview, adjust, then Export";
                        color: #444;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.status-text != "": Text {
                        text: root.status-text;
                        color: #666;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }

                // Aspect-constrained preview container. When "auto"
                // (default) it fills the parent; when a ratio is
                // chosen it shrinks one axis to maintain that ratio,
                // centered within the outer Rectangle.
                preview-box := Rectangle {
                    property <float> ratio:
                        root.preview-aspect == "16:9" ? (16.0 / 9.0)
                      : root.preview-aspect == "4:3"  ? (4.0 / 3.0)
                      : root.preview-aspect == "21:9" ? (21.0 / 9.0)
                      : 0;

                    property <length> fit-w:
                        ratio > 0 ? min(parent.width, parent.height * ratio / 1.0) : parent.width;
                    property <length> fit-h:
                        ratio > 0 ? min(parent.height, parent.width / ratio * 1.0) : parent.height;

                    width: fit-w;
                    height: fit-h;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    clip: true;

                    // Letterboxed content rect for lens-preview mode
                    // (the `contain`-fit rect Slint computes internally
                    // for the Image below, but not exposed as a
                    // property - reconstructed here since the ROI
                    // overlay/pointer math needs its exact origin/size).
                    // Unused outside lens-preview mode.
                    property <float> box-aspect: preview-box.width / preview-box.height;
                    property <length> base-w:
                        root.lens-frame-aspect > box-aspect ? preview-box.width : preview-box.height * root.lens-frame-aspect;
                    property <length> base-h:
                        root.lens-frame-aspect > box-aspect ? preview-box.width / root.lens-frame-aspect : preview-box.height;
                    property <length> content-w: base-w * root.lens-zoom;
                    property <length> content-h: base-h * root.lens-zoom;
                    property <length> content-x: (preview-box.width - content-w) / 2 + root.lens-pan-x;
                    property <length> content-y: (preview-box.height - content-h) / 2 + root.lens-pan-y;

                    if root.files-loaded: Image {
                        source: root.preview-frame;
                        image-fit: contain;
                        x: root.lens-preview-active ? preview-box.content-x : 0px;
                        y: root.lens-preview-active ? preview-box.content-y : 0px;
                        width: root.lens-preview-active ? preview-box.content-w : preview-box.width;
                        height: root.lens-preview-active ? preview-box.content-h : preview-box.height;
                    }

                    // Preview is released during export to free VRAM; show
                    // that it is intentionally paused, not frozen/broken.
                    if root.files-loaded && root.export-in-progress: Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #000000bb;
                        Text {
                            text: "Preview paused during export";
                            color: #dddddd;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // ROI polygon outline (visible in lens preview mode),
                    // drawn in the same normalized 0..1 space as the
                    // points via the Path's viewbox, so it tracks the
                    // image through zoom/pan without any pixel math here.
                    //
                    // Path always fits its viewbox into its box with
                    // *uniform* (aspect-preserving) scaling - there's no
                    // anisotropic/stretch option. A plain 1x1 viewbox
                    // against a non-square content box (any real camera
                    // aspect ratio) therefore scales/centers differently
                    // than the dot overlay below (which maps x/y to
                    // content-w/content-h independently), so line
                    // endpoints drift away from their dots the further a
                    // point sits from center. Fixed by giving the viewbox
                    // the same aspect ratio as the box: `roi-path-commands`
                    // pre-scales its y-values by the matching factor
                    // (see `roi_path_commands` in main.rs) so the
                    // now-uniform fit reproduces the dots' anisotropic
                    // mapping exactly.
                    if root.lens-preview-active && root.has-roi: Path {
                        x: preview-box.content-x;
                        y: preview-box.content-y;
                        width: preview-box.content-w;
                        height: preview-box.content-h;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 1;
                        viewbox-height: 1.0 / root.lens-frame-aspect;
                        stroke: #0f08;
                        stroke-width: 2px;
                        commands: root.roi-path-commands;
                    }

                    // ROI vertex overlay (visible in lens preview mode).
                    // Absolute-positioned dots at each polygon vertex,
                    // positioned within the letterboxed content rect so
                    // they track the image through zoom/pan.
                    for idx in root.roi-points-x.length: Rectangle {
                        visible: root.lens-preview-active && root.has-roi;
                        x: preview-box.content-x + root.roi-points-x[idx] * preview-box.content-w - 4px;
                        y: preview-box.content-y + root.roi-points-y[idx] * preview-box.content-h - 4px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #0f08;
                        border-width: 1px;
                        border-color: #0f0;
                    }

                    // Goal-geometry polygon outline - same lens-preview
                    // content rect and `Path` viewbox-aspect approach as the
                    // ROI outline above (see its comment for why the
                    // y-scaling is needed), since goal points are stored in
                    // the same raw-distorted-frame-normalized space as
                    // FieldRoi. Deliberately a different color (orange, not
                    // green) so the two calibrated boundaries are never
                    // confused at a glance, even though only one is
                    // editable at a time (`zone-edit-type`).
                    if root.lens-preview-active && root.has-goal-geometry: Path {
                        x: preview-box.content-x;
                        y: preview-box.content-y;
                        width: preview-box.content-w;
                        height: preview-box.content-h;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 1;
                        viewbox-height: 1.0 / root.lens-frame-aspect;
                        stroke: #ff8c1acc;
                        stroke-width: 2px;
                        commands: root.goal-path-commands;
                    }

                    // Goal-geometry vertex overlay - same idea as the ROI
                    // dots above, same content rect.
                    for idx in root.goal-points-x.length: Rectangle {
                        visible: root.lens-preview-active && root.has-goal-geometry;
                        x: preview-box.content-x + root.goal-points-x[idx] * preview-box.content-w - 4px;
                        y: preview-box.content-y + root.goal-points-y[idx] * preview-box.content-h - 4px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #ff8c1a88;
                        border-width: 1px;
                        border-color: #ff8c1a;
                    }

                    // Pan/zoom (panorama or lens-preview) and, in lens
                    // preview + ROI-edit mode, field-boundary point
                    // editing: click empty space to add a point, drag an
                    // existing point to move it, right-click a point to
                    // delete it. A child of preview-box (not a sibling)
                    // so its coordinates are relative to the same
                    // content rect the ROI overlay above uses - matters
                    // once `preview-aspect` letterboxes the image.
                    //
                    // Click vs. drag on empty space is disambiguated by
                    // movement, not by which handler fires: pressing down
                    // on empty space only *tentatively* marks a possible
                    // add (`roi-click-pending`) - it's committed on
                    // release only if the pointer never moved past a
                    // small threshold, otherwise the gesture is treated
                    // as a pan instead. Without this, every left-press
                    // would count as "start of a drag" and panning by
                    // dragging empty space would be impossible while
                    // editing (confirmed broken in the first version of
                    // this feature).
                    drag := TouchArea {
                        enabled: root.files-loaded;
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        property <length> last-x: 0px;
                        property <length> last-y: 0px;
                        property <length> press-x: 0px;
                        property <length> press-y: 0px;
                        property <int> roi-dragging-index: -1;
                        property <bool> roi-click-pending: false;
                        property <length> local-x: self.mouse-x - preview-box.content-x;
                        property <length> local-y: self.mouse-y - preview-box.content-y;
                        property <bool> local-in-bounds:
                            self.local-x >= 0px && self.local-x <= preview-box.content-w
                            && self.local-y >= 0px && self.local-y <= preview-box.content-h;
                        property <int> goal-dragging-index: -1;
                        property <bool> goal-click-pending: false;
                        // Whether the mouse is currently near the seam debug
                        // line (hover feedback / drag gating - see
                        // `seam-hit-test`'s own doc). Only meaningful outside
                        // lens-preview mode, same scoping the pan/seam-drag
                        // logic below already uses.
                        property <bool> hovering-seam-line: false;
                        // Set on press only when the press itself started on
                        // the line - a drag started elsewhere stays a normal
                        // pan/tilt even while Show seam line is on.
                        property <bool> seam-dragging: false;
                        mouse-cursor: self.seam-dragging ? grabbing : (self.hovering-seam-line ? grab : default);

                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.last-x = self.mouse-x;
                                self.last-y = self.mouse-y;
                                self.press-x = self.mouse-x;
                                self.press-y = self.mouse-y;
                                self.roi-click-pending = false;
                                self.goal-click-pending = false;
                                self.seam-dragging = !root.lens-preview-active && root.show-seam-line
                                    && root.seam-hit-test(
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px,
                                        preview-box.width / 1px,
                                        preview-box.height / 1px,
                                    );

                                if (root.lens-preview-active && root.zone-edit-mode && root.zone-edit-type == "roi" && self.local-in-bounds) {
                                    if (e.button == PointerEventButton.right) {
                                        root.roi-pointer-delete(
                                            self.local-x / 1px,
                                            self.local-y / 1px,
                                            preview-box.content-w / 1px,
                                            preview-box.content-h / 1px,
                                        );
                                    } else if (e.button == PointerEventButton.left) {
                                        self.roi-dragging-index = root.roi-pointer-hit-test(
                                            self.local-x / 1px,
                                            self.local-y / 1px,
                                            preview-box.content-w / 1px,
                                            preview-box.content-h / 1px,
                                        );
                                        if (self.roi-dragging-index < 0) {
                                            self.roi-click-pending = true;
                                        }
                                    }
                                } else if (root.lens-preview-active && root.zone-edit-mode && root.zone-edit-type == "goal" && self.local-in-bounds) {
                                    if (e.button == PointerEventButton.right) {
                                        root.goal-pointer-delete(
                                            self.local-x / 1px,
                                            self.local-y / 1px,
                                            preview-box.content-w / 1px,
                                            preview-box.content-h / 1px,
                                        );
                                    } else if (e.button == PointerEventButton.left) {
                                        self.goal-dragging-index = root.goal-pointer-hit-test(
                                            self.local-x / 1px,
                                            self.local-y / 1px,
                                            preview-box.content-w / 1px,
                                            preview-box.content-h / 1px,
                                        );
                                        if (self.goal-dragging-index < 0) {
                                            self.goal-click-pending = true;
                                        }
                                    }
                                }
                            }
                            if (e.kind == PointerEventKind.up) {
                                if (self.roi-dragging-index >= 0) {
                                    root.roi-pointer-up();
                                    self.roi-dragging-index = -1;
                                }
                                if (self.roi-click-pending) {
                                    root.roi-pointer-add(
                                        self.local-x / 1px,
                                        self.local-y / 1px,
                                        preview-box.content-w / 1px,
                                        preview-box.content-h / 1px,
                                    );
                                    self.roi-click-pending = false;
                                }
                                if (self.goal-dragging-index >= 0) {
                                    root.goal-pointer-up();
                                    self.goal-dragging-index = -1;
                                }
                                if (self.goal-click-pending) {
                                    root.goal-pointer-add(
                                        self.local-x / 1px,
                                        self.local-y / 1px,
                                        preview-box.content-w / 1px,
                                        preview-box.content-h / 1px,
                                    );
                                    self.goal-click-pending = false;
                                }
                                self.seam-dragging = false;
                            }
                        }

                        moved => {
                            // Hover feedback, independent of press state, so
                            // the cursor already shows a hand before the user
                            // clicks.
                            self.hovering-seam-line = !root.lens-preview-active && root.show-seam-line
                                && root.seam-hit-test(
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px,
                                    preview-box.width / 1px,
                                    preview-box.height / 1px,
                                );

                            if (self.pressed) {
                                if (root.lens-preview-active && root.zone-edit-mode && root.zone-edit-type == "roi" && self.roi-dragging-index >= 0) {
                                    root.roi-pointer-drag(
                                        self.roi-dragging-index,
                                        self.local-x / 1px,
                                        self.local-y / 1px,
                                        preview-box.content-w / 1px,
                                        preview-box.content-h / 1px,
                                    );
                                } else if (root.lens-preview-active && root.zone-edit-mode && root.zone-edit-type == "roi" && self.roi-click-pending
                                           && (Math.abs((self.mouse-x - self.press-x) / 1px) > 4
                                               || Math.abs((self.mouse-y - self.press-y) / 1px) > 4)) {
                                    // Moved past the click threshold: this is a
                                    // pan, not a click-to-add - cancel the
                                    // pending add and fall into panning from
                                    // here on (the next `moved` naturally hits
                                    // the plain lens-preview-active branch
                                    // below since both flags are now false).
                                    self.roi-click-pending = false;
                                    root.lens-pan-x += self.mouse-x - self.last-x;
                                    root.lens-pan-y += self.mouse-y - self.last-y;
                                } else if (root.lens-preview-active && root.zone-edit-mode && root.zone-edit-type == "roi" && self.roi-click-pending) {
                                    // Still within the click threshold - wait.
                                } else if (root.lens-preview-active && root.zone-edit-mode && root.zone-edit-type == "goal" && self.goal-dragging-index >= 0) {
                                    root.goal-pointer-drag(
                                        self.goal-dragging-index,
                                        self.local-x / 1px,
                                        self.local-y / 1px,
                                        preview-box.content-w / 1px,
                                        preview-box.content-h / 1px,
                                    );
                                } else if (root.lens-preview-active && root.zone-edit-mode && root.zone-edit-type == "goal" && self.goal-click-pending
                                           && (Math.abs((self.mouse-x - self.press-x) / 1px) > 4
                                               || Math.abs((self.mouse-y - self.press-y) / 1px) > 4)) {
                                    // Same click-vs-pan disambiguation as the ROI
                                    // branch above.
                                    self.goal-click-pending = false;
                                    root.lens-pan-x += self.mouse-x - self.last-x;
                                    root.lens-pan-y += self.mouse-y - self.last-y;
                                } else if (root.lens-preview-active && root.zone-edit-mode && root.zone-edit-type == "goal" && self.goal-click-pending) {
                                    // Still within the click threshold - wait.
                                } else if (root.lens-preview-active) {
                                    root.lens-pan-x += self.mouse-x - self.last-x;
                                    root.lens-pan-y += self.mouse-y - self.last-y;
                                } else if (root.show-seam-line && self.seam-dragging) {
                                    // Seam-edit mode: horizontal drag nudges the
                                    // seam instead of panning, normalized by
                                    // width so sensitivity is independent of
                                    // window/panel size. Only reached when the
                                    // press itself started on the line (see
                                    // `seam-dragging`).
                                    root.seam-drag((self.mouse-x - self.last-x) / self.width);
                                } else if (root.show-seam-line && root.shift-held) {
                                    // Show seam line is on, but Shift is held:
                                    // allow vertical-only panning (e.g. to
                                    // check the seam against content higher/
                                    // lower in frame) without also letting a
                                    // horizontal drag move the seam out from
                                    // under you.
                                    root.pan(0, (self.mouse-y - self.last-y) / 1px);
                                } else if (root.show-seam-line) {
                                    // Show seam line is on but the drag didn't
                                    // start on the line itself: suppress pan
                                    // entirely (dragging off-line would
                                    // otherwise move the view out from under
                                    // the seam you're trying to line up).
                                    // Zoom (scroll-event below) is unaffected.
                                    // Hold Shift to allow vertical-only pan.
                                } else {
                                    root.pan(
                                        (self.mouse-x - self.last-x) / 1px,
                                        (self.mouse-y - self.last-y) / 1px,
                                    );
                                }
                                self.last-x = self.mouse-x;
                                self.last-y = self.mouse-y;
                            }
                        }

                        scroll-event(e) => {
                            if (root.lens-preview-active) {
                                // Sign matches the normal view's `zoom(-delta-y/40px)`:
                                // there, a positive delta-y narrows FOV (zooms in);
                                // here, since higher lens-zoom means more zoomed in
                                // (opposite convention from FOV), the same delta-y
                                // sign must INCREASE lens-zoom, not decrease it -
                                // otherwise the same scroll direction zooms in on
                                // one view and out on the other.
                                root.lens-zoom = max(1.0, min(8.0, root.lens-zoom + e.delta-y / 400px));
                            } else {
                                root.zoom(-e.delta-y / 40px);
                            }
                            return accept;
                        }
                    }
                }

                // Current view state, surfaced over the preview where the
                // eye already is. Clicking expands the badge into the actual
                // FOV slider + Constrained look toggle, replacing the old
                // separate "Camera" section in the right panel entirely.
                // Hidden until a clip loads.
                //
                // Click-to-open, not hover: a hover-driven version (has-hover
                // gating which content is instantiated) flickered and ate
                // clicks, because the Slider/CheckBox that appear inside are
                // themselves hoverable/clickable - the moment the pointer
                // reached them they captured hover away from the badge's own
                // TouchArea, which then collapsed the popover out from under
                // the pointer, which exposed the badge again, which re-opened
                // it, looping. Click-to-toggle (with an explicit × to close)
                // is the same reliable pattern already used by every
                // collapsible section in this app (SectionHeader) and has no
                // such feedback loop.
                if root.files-loaded && !root.lens-preview-active: fov-box := Rectangle {
                    x: (parent.width - self.width) / 2;
                    // Negative: this element is a child of preview-column,
                    // which sits directly below the 42px toolbar - this pulls
                    // the (collapsed, 26px-tall) pill up to vertically center
                    // in the toolbar band above, so it reads as level with
                    // the "Files" button rather than floating lower down over
                    // the video. preview-column itself isn't clipped (only
                    // preview-box, its child, is), so the negative offset
                    // renders fine instead of being cut off.
                    y: -34px;
                    width: 190px;
                    height: 92px;
                    clip: true;

                    property <bool> open: false;

                    if !fov-box.open: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        width: fov-pill-content.preferred-width + 24px;
                        height: 26px;
                        border-radius: 13px;
                        background: #0d0f11d0;
                        border-width: 1px;
                        border-color: #2a2e33;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { fov-box.open = true; }
                        }

                        fov-pill-content := HorizontalLayout {
                            spacing: 7px;
                            alignment: center;
                            Text {
                                text: "FOV " + round(root.fov) + "°";
                                color: #9aa0a7;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            if root.use-constrained-look: Text {
                                text: "· Constrained";
                                color: #6a7077;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if self.open: Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 10px;
                        background: #0d0f11d0;
                        border-width: 1px;
                        border-color: #2a2e33;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                Text {
                                    text: "FOV " + round(root.fov) + "°";
                                    color: #ccc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    width: 16px;
                                    height: 16px;
                                    mouse-cursor: pointer;
                                    clicked => { fov-box.open = false; }
                                    Text {
                                        text: "×";
                                        color: #888;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Slider {
                                minimum: 20;
                                maximum: 150;
                                value <=> root.fov;
                                changed(v) => { root.changed-fov(v); }
                            }
                            CheckBox {
                                text: "Constrained look";
                                checked <=> root.use-constrained-look;
                                toggled => { root.changed-constrained-look(); }
                            }
                        }
                    }
                }

                // Reset-view button - positioned independently (not inside
                // the FOV badge above) so it can never shift that badge's
                // centering. Same dark-pill styling as the FOV badge (not a
                // FlatButton) so the two read as a matched pair rather than
                // one being the app-wide blue action-button style.
                if root.files-loaded && !root.lens-preview-active: Rectangle {
                    x: parent.width / 2 + 78px;
                    y: -34px;
                    width: 70px;
                    height: 26px;
                    border-radius: 13px;
                    background: #0d0f11d0;
                    border-width: 1px;
                    border-color: #2a2e33;

                    reset-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.reset-view(); }
                    }

                    Text {
                        text: "Reset";
                        color: reset-touch.has-hover ? #ccc : #9aa0a7;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Zone-type switcher (ROI vs GOAL), top-left of the preview
                // while a zone-edit session is active - determines which
                // polygon the click/drag/right-click gestures below apply
                // to. Positioned separately from the Left/Right pill
                // (top-center, below) rather than combined into one wider
                // pill, so both stay comfortably tappable.
                if root.zone-edit-mode: Rectangle {
                    x: 12px;
                    y: 12px;
                    width: zone-type-pill.preferred-width + 8px;
                    height: 34px;
                    border-radius: 17px;
                    background: #0d0f11d0;
                    border-width: 1px;
                    border-color: #2a2e33;
                    zone-type-pill := HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        FlatButton {
                            text: "ROI";
                            primary: root.zone-edit-type == "roi";
                            clicked => { root.zone-edit-type = "roi"; }
                        }
                        FlatButton {
                            text: "GOAL";
                            primary: root.zone-edit-type == "goal";
                            clicked => { root.zone-edit-type = "goal"; }
                        }
                    }
                }

                // Side switcher, surfaced front-and-center while editing
                // either zone type (the primary reason you'd need it in
                // the moment) - not shown otherwise, since the general
                // Lens section elsewhere covers normal lens-preview use.
                // Shared between ROI and GOAL editing (one `lens-preview-
                // side` value - ROI reads it as which camera to show, GOAL
                // as which goal's polygon to edit).
                if root.zone-edit-mode: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 12px;
                    width: zone-side-pill.preferred-width + 8px;
                    height: 34px;
                    border-radius: 17px;
                    background: #0d0f11d0;
                    border-width: 1px;
                    border-color: #2a2e33;
                    zone-side-pill := HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        FlatButton {
                            text: "Left";
                            primary: root.lens-preview-side == "left";
                            clicked => { root.lens-preview-side = "left"; root.changed-lens-preview(); }
                        }
                        FlatButton {
                            text: "Right";
                            primary: root.lens-preview-side == "right";
                            clicked => { root.lens-preview-side = "right"; root.changed-lens-preview(); }
                        }
                    }
                }
            }

            // Right-side controls panel. Collapsible sections keep
            // the default view compact; ScrollView catches overflow
            // when advanced sections are expanded on short screens.
            if root.controls-open: Rectangle {
                background: root.bg-panel;
                width: root.right-panel-width;

                // Resize handle on the left edge
                Rectangle {
                    x: 0;
                    width: 6px;
                    height: parent.height;
                    background: right-resize.has-hover || right-resize.pressed ? #555 : #333;

                    right-resize := TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            if (self.pressed) {
                                root.right-panel-width = max(200px, root.right-panel-width - (self.mouse-x - self.pressed-x));
                            }
                        }
                    }
                }

                ScrollView {
                    horizontal-scrollbar-policy: always-off;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    alignment: start;

                    // Camera controls (FOV, Constrained look, Reset View) moved
                    // to the hover-expandable pill over the preview - see the
                    // `fov-hover` block above the preview column. Kept only for
                    // lens-preview mode, which that pill doesn't cover.
                    if root.lens-preview-active: FlatButton {
                        text: "Reset Zoom";
                        clicked => {
                            root.lens-zoom = 1.0;
                            root.lens-pan-x = 0px;
                            root.lens-pan-y = 0px;
                        }
                    }

                    if !root.lens-preview-active: Rectangle { height: 1px; background: root.border-subtle; }

                    // ── Audio Sync (collapsible): overlaid L/R waveform ──
                    // around the playhead, so a sync_offset error shows up
                    // as a visible shift between the two traces. Placed
                    // above Lens - sync is checked/adjusted more often
                    // than lens fine-tuning during a normal calibration
                    // pass.
                    audio-section := SectionHeader {
                        title: "Audio Sync Waveform";
                        expanded <=> root.audio-sync-expanded;
                    }

                    if audio-section.expanded: VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: "L (blue) / R (orange), " + root.audio-window-frames + " frames around playhead. Aligned peaks = in sync.";
                            color: root.text-muted; font-size: 11px; wrap: word-wrap;
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 3px;
                                Tip {
                                    tip: "Number of frames of audio shown around the playhead.";
                                    Text { text: "Window:"; color: root.text-muted; font-size: 10px; vertical-alignment: center; }
                                }
                                // Deliberately outside the `Tip` above: `Tip` inherits
                                // `TouchArea`, which grabs mouse presses before a nested
                                // `NumEdit` can claim keyboard focus, making it very
                                // hard to reliably click into and type in.
                                NumEdit {
                                    text: root.audio-window-frames;
                                    width: 64px;
                                    accepted => {
                                        root.audio-window-frames = self.text.to-float();
                                        root.changed-audio-window-frames(self.text.to-float());
                                    }
                                    escaped => { self.text = root.audio-window-frames; }
                                }
                                Text { text: "frames"; color: root.text-muted; font-size: 10px; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 3px;
                                Tip {
                                    tip: "Height of the waveform display.";
                                    Text { text: "Height:"; color: root.text-muted; font-size: 10px; vertical-alignment: center; }
                                }
                                NumEdit {
                                    text: root.audio-waveform-height-px;
                                    width: 64px;
                                    accepted => {
                                        root.audio-waveform-height-px = min(300, max(40, self.text.to-float()));
                                    }
                                    escaped => { self.text = root.audio-waveform-height-px; }
                                }
                                Text { text: "px"; color: root.text-muted; font-size: 10px; vertical-alignment: center; }
                            }
                        }

                        waveform-area := Rectangle {
                            height: root.audio-waveform-height-px * 1px;
                            background: root.bg-base;
                            border-radius: 4px;
                            clip: true;

                            property <float> bucket-count: max(1, root.audio-envelope-left.length) * 1.0;
                            property <length> bar-w: waveform-area.width / bucket-count;

                            // Background grid, purely a reading aid:
                            // horizontal thirds + a vertical line
                            // every 8 buckets.
                            for row in [0.25, 0.5, 0.75]: Rectangle {
                                x: 0px; width: waveform-area.width;
                                y: waveform-area.height * row; height: 1px;
                                background: #ffffff16;
                            }
                            for i in 9: Rectangle {
                                x: waveform-area.width * (i + 1) / 10; width: 1px;
                                y: 0px; height: waveform-area.height;
                                background: #ffffff10;
                            }

                            // Both channels are plain (unmirrored)
                            // lines sharing one axis - 0 at the
                            // bottom, loudest point at the top - so a
                            // real sync offset reads as a horizontal
                            // shift between the two lines' peaks,
                            // same as any two-series line chart.
                            //
                            // Each point is a thin horizontal marker
                            // PLUS a vertical connector to the next
                            // point's height, so consecutive buckets
                            // join into a continuous "staircase" line
                            // instead of reading as scattered dots.
                            // Not a `Path`: Slint fits a `Path`'s
                            // viewbox uniformly, which would squash a
                            // wide/short envelope flat; and Rectangle
                            // has no rotation for a true diagonal
                            // stroke, so this approximates one.
                            for v[idx] in root.audio-envelope-left: Rectangle {
                                x: idx * waveform-area.bar-w;
                                width: waveform-area.bar-w;
                                height: 1px;
                                y: waveform-area.height * (1.0 - v) - 0.5px;
                                background: #5fb8ff;
                            }
                            for v[idx] in root.audio-envelope-left: Rectangle {
                                property <bool> has-next: idx + 1 < root.audio-envelope-left.length;
                                property <float> next-v: has-next ? root.audio-envelope-left[idx + 1] : v;
                                property <length> y0: waveform-area.height * (1.0 - v);
                                property <length> y1: waveform-area.height * (1.0 - next-v);
                                visible: has-next;
                                x: (idx + 1) * waveform-area.bar-w - 0.5px;
                                width: 1px;
                                y: min(y0, y1);
                                height: max(y0, y1) - min(y0, y1) + 1px;
                                background: #5fb8ff;
                            }
                            for v[idx] in root.audio-envelope-right: Rectangle {
                                x: idx * waveform-area.bar-w;
                                width: waveform-area.bar-w;
                                height: 1px;
                                y: waveform-area.height * (1.0 - v) - 0.5px;
                                background: #ff9f5f;
                            }
                            for v[idx] in root.audio-envelope-right: Rectangle {
                                property <bool> has-next: idx + 1 < root.audio-envelope-right.length;
                                property <float> next-v: has-next ? root.audio-envelope-right[idx + 1] : v;
                                property <length> y0: waveform-area.height * (1.0 - v);
                                property <length> y1: waveform-area.height * (1.0 - next-v);
                                visible: has-next;
                                x: (idx + 1) * waveform-area.bar-w - 0.5px;
                                width: 1px;
                                y: min(y0, y1);
                                height: max(y0, y1) - min(y0, y1) + 1px;
                                background: #ff9f5f;
                            }

                            Rectangle {
                                x: waveform-area.width * 0.5 - 1px;
                                width: 2px;
                                height: waveform-area.height;
                                background: #ffffff55;
                            }

                            if root.audio-envelope-left.length == 0 && root.audio-envelope-right.length == 0: Text {
                                text: "Computing…";
                                color: root.text-muted; font-size: 10px;
                                x: 6px; y: 6px;
                            }
                        }
                    }

                    if !audio-section.expanded: Rectangle { height: 1px; background: #2a2a2a; }

                    // ── Lens (collapsible: info always, sliders on demand) ──
                    lens-section := SectionHeader {
                        title: root.lens-info-available
                            ? "Lens - " + root.lens-left-camera
                            : "Lens";
                        expanded: false;
                    }

                    if lens-section.expanded && root.files-loaded: VerticalLayout {
                        spacing: 6px;

                        if root.lens-info-available: VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "L"; color: #8ae68a; font-size: 10px; font-weight: 600; vertical-alignment: center; width: 14px; }
                                Text { text: root.lens-left-source + " - " + root.lens-left-camera; color: #ccc; font-size: 10px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "R"; color: #8ae68a; font-size: 10px; font-weight: 600; vertical-alignment: center; width: 14px; }
                                Text { text: root.lens-right-source + " - " + root.lens-right-camera; color: #ccc; font-size: 10px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }

                        if !root.lens-info-available: Text {
                            text: "Auto-calibrate to detect lens.";
                            color: #777; font-size: 11px;
                        }

                        FlatButton {
                            text: "Browse profiles...";
                            clicked => { root.lens-picker-open = true; }
                        }

                        Rectangle { height: 4px; }

                        CheckBox {
                            text: "Lens correction";
                            checked: root.lens-correction-amount > 0.5;
                            toggled => {
                                root.lens-correction-amount = self.checked ? 1.0 : 0.0;
                                root.changed-lens-correction(root.lens-correction-amount);
                            }
                        }

                        CheckBox {
                            text: "Lens preview (single camera)";
                            checked <=> root.lens-preview-active;
                            toggled => { root.changed-lens-preview(); }
                        }

                        if root.lens-preview-active: HorizontalLayout {
                            spacing: 4px;
                            FlatButton { text: "Left"; primary: root.lens-preview-side == "left"; clicked => { root.lens-preview-side = "left"; root.changed-lens-preview(); } }
                            FlatButton { text: "Right"; primary: root.lens-preview-side == "right"; clicked => { root.lens-preview-side = "right"; root.changed-lens-preview(); } }
                        }

                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                FlatButton { text: "Left"; primary: root.lens-selected-camera == "left"; clicked => { root.lens-selected-camera = "left"; } }
                                FlatButton { text: "Right"; primary: root.lens-selected-camera == "right"; clicked => { root.lens-selected-camera = "right"; } }
                                FlatButton { text: "Both"; primary: root.lens-selected-camera == "both"; clicked => { root.lens-selected-camera = "both"; } }
                            }

                            CalGroupBox {
                                title: "LENS PARAMETERS";

                                if root.lens-selected-camera == "left" || root.lens-selected-camera == "both": VerticalLayout {
                                    spacing: 3px;
                                    LabeledSlider { tip: "Horizontal focal length in pixels."; label: "fx"; minimum: root.lens-fx-min; maximum: root.lens-fx-max; value <=> root.lens-left-fx; decimals: 0; step: 1; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Vertical focal length in pixels."; label: "fy"; minimum: root.lens-fy-min; maximum: root.lens-fy-max; value <=> root.lens-left-fy; decimals: 0; step: 1; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Horizontal optical center in pixels."; label: "cx"; minimum: root.lens-cx-min; maximum: root.lens-cx-max; value <=> root.lens-left-cx; decimals: 0; step: 1; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Vertical optical center in pixels."; label: "cy"; minimum: root.lens-cy-min; maximum: root.lens-cy-max; value <=> root.lens-left-cy; decimals: 0; step: 1; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Fisheye distortion coefficient 1 (KB4 model)."; label: "k1"; minimum: -root.lens-k-range; maximum: root.lens-k-range; value <=> root.lens-left-k1; decimals: 2; step: 0.01; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Fisheye distortion coefficient 2 (KB4 model)."; label: "k2"; minimum: -root.lens-k-range; maximum: root.lens-k-range; value <=> root.lens-left-k2; decimals: 2; step: 0.01; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Fisheye distortion coefficient 3 (KB4 model)."; label: "k3"; minimum: -root.lens-k-range; maximum: root.lens-k-range; value <=> root.lens-left-k3; decimals: 2; step: 0.01; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Fisheye distortion coefficient 4 (KB4 model)."; label: "k4"; minimum: -root.lens-k-range; maximum: root.lens-k-range; value <=> root.lens-left-k4; decimals: 2; step: 0.01; changed(v) => { root.changed-lens-param(); } }
                                }

                                if root.lens-selected-camera == "right": VerticalLayout {
                                    spacing: 3px;
                                    LabeledSlider { tip: "Horizontal focal length in pixels."; label: "fx"; minimum: root.lens-fx-min; maximum: root.lens-fx-max; value <=> root.lens-right-fx; decimals: 0; step: 1; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Vertical focal length in pixels."; label: "fy"; minimum: root.lens-fy-min; maximum: root.lens-fy-max; value <=> root.lens-right-fy; decimals: 0; step: 1; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Horizontal optical center in pixels."; label: "cx"; minimum: root.lens-cx-min; maximum: root.lens-cx-max; value <=> root.lens-right-cx; decimals: 0; step: 1; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Vertical optical center in pixels."; label: "cy"; minimum: root.lens-cy-min; maximum: root.lens-cy-max; value <=> root.lens-right-cy; decimals: 0; step: 1; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Fisheye distortion coefficient 1 (KB4 model)."; label: "k1"; minimum: -root.lens-k-range; maximum: root.lens-k-range; value <=> root.lens-right-k1; decimals: 2; step: 0.01; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Fisheye distortion coefficient 2 (KB4 model)."; label: "k2"; minimum: -root.lens-k-range; maximum: root.lens-k-range; value <=> root.lens-right-k2; decimals: 2; step: 0.01; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Fisheye distortion coefficient 3 (KB4 model)."; label: "k3"; minimum: -root.lens-k-range; maximum: root.lens-k-range; value <=> root.lens-right-k3; decimals: 2; step: 0.01; changed(v) => { root.changed-lens-param(); } }
                                    LabeledSlider { tip: "Fisheye distortion coefficient 4 (KB4 model)."; label: "k4"; minimum: -root.lens-k-range; maximum: root.lens-k-range; value <=> root.lens-right-k4; decimals: 2; step: 0.01; changed(v) => { root.changed-lens-param(); } }
                                }
                            }

                            FlatButton { text: "Reset Lens"; enabled: root.lens-dirty; clicked => { root.reset-lens(); } }
                        }
                    }

                    if !lens-section.expanded: Rectangle { height: 1px; background: #2a2a2a; }

                    // ── Calibration (collapsible) ──
                    cal-section := SectionHeader {
                        title: "Calibration";
                        expanded: false;
                    }

                    if cal-section.expanded: VerticalLayout {
                        spacing: 10px;

                        CalGroupBox {
                            title: "GLOBAL PARAMETERS";

                            LabeledSlider {
                                tip: "Overlap between the two camera planes; controls how much of each image is used.";
                                label: "Intersect";
                                minimum: -1.0;
                                maximum: 1.0;
                                value <=> root.cal-intersect;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-intersect(v); }
                            }

                            LabeledSlider {
                                tip: "Distance of the virtual camera from the stitch origin; affects parallax at the seam.";
                                label: "Camera axis offset";
                                minimum: -0.6;
                                maximum: 0.6;
                                value <=> root.cal-camera-axis-offset;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-camera-axis-offset(v); }
                            }
                        }

                        CalGroupBox {
                            title: "LEFT CAMERA";

                            LabeledSlider {
                                tip: "Independent rotation of the left camera's content. Manual control for the same angle the \"Force extra rotation fit (z_rz)\" checkbox below lets auto-calibrate solve for - use this to fine-tune by hand instead of (or after) re-running auto-calibrate.";
                                label: "Rotation";
                                minimum: -0.3;
                                maximum: 0.3;
                                value <=> root.cal-z-rz;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-z-rz(v); }
                            }

                            LabeledSlider {
                                tip: "Same as ground_tilt_x, for the left camera's content (z-plane).";
                                label: "Near-field Tilt";
                                minimum: -0.3;
                                maximum: 0.3;
                                value <=> root.cal-ground-tilt-z;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-ground-tilt-z(v); }
                            }

                            LabeledSlider {
                                tip: "Same as top_tilt_x, for the left camera's content (z-plane).";
                                label: "Far-field Tilt";
                                minimum: -0.3;
                                maximum: 0.3;
                                value <=> root.cal-top-tilt-z;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-top-tilt-z(v); }
                            }
                        }

                        CalGroupBox {
                            title: "RIGHT CAMERA";

                            LabeledSlider {
                                tip: "Vertical alignment correction between the two camera planes.";
                                label: "Vertical Shift";
                                minimum: -0.1;
                                maximum: 0.1;
                                value <=> root.cal-x-ty;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-x-ty(v); }
                            }

                            LabeledSlider {
                                tip: "Independent rotation of the right camera's content. Manual control for the same angle the \"Force extra rotation fit (x_rx)\" checkbox below lets auto-calibrate solve for - use this to fine-tune by hand instead of (or after) re-running auto-calibrate.";
                                label: "Rotation";
                                minimum: -0.3;
                                maximum: 0.3;
                                value <=> root.cal-x-rx;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-x-rx(v); }
                            }

                            LabeledSlider {
                                tip: "Near-field ground-plane tilt correction for the right camera's content (x-plane). Fixes a seam step in ground lines close to the camera that the flat two-plane model can't otherwise correct - only affects the bottom of frame, close to the camera; leaves everything else untouched.";
                                label: "Near-field Tilt";
                                minimum: -0.3;
                                maximum: 0.3;
                                value <=> root.cal-ground-tilt-x;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-ground-tilt-x(v); }
                            }

                            LabeledSlider {
                                tip: "Top-of-frame tilt correction for the right camera's content (x-plane). Mirror of ground_tilt_x, for far background content (distant structures, goal frames, skyline) instead of the near field - only affects the top of frame; leaves the ground band untouched. Manual only - no auto-fit yet.";
                                label: "Far-field Tilt";
                                minimum: -0.3;
                                maximum: 0.3;
                                value <=> root.cal-top-tilt-x;
                                decimals: 5;
                                step: 0.001;
                                changed(v) => { root.changed-cal-top-tilt-x(v); }
                            }
                        }

                        CalGroupBox {
                            title: "BAND WIDTH";

                            LabeledSlider {
                                tip: "How far into the frame ground_tilt_x/z's correction extends before reaching full strength (the ramp always starts at the same fixed point close to the seam). Wider spreads the correction more gradually; narrower concentrates it closer to the very bottom edge. Shared by both ground_tilt_x and ground_tilt_z.";
                                label: "Near-tilt";
                                minimum: 0.09;
                                maximum: 0.4;
                                value <=> root.cal-ground-tilt-band-width;
                                decimals: 5;
                                step: 0.01;
                                changed(v) => { root.changed-cal-ground-tilt-band-width(v); }
                            }

                            LabeledSlider {
                                tip: "Same as ground_tilt_band_width, for top_tilt_x/z's band (top of frame instead of the bottom).";
                                label: "Far-tilt";
                                minimum: 0.09;
                                maximum: 0.4;
                                value <=> root.cal-top-tilt-band-width;
                                decimals: 5;
                                step: 0.01;
                                changed(v) => { root.changed-cal-top-tilt-band-width(v); }
                            }
                        }

                        // Saving lives in one place: the "Save Calibration"
                        // button in the Files-panel Calibration card (enabled on
                        // cal/lens dirty, saves the whole calibration incl. lens
                        // + blend). This section keeps only the contextual
                        // layout Reset so there is no duplicate save button.
                        FlatButton {
                            text: "Reset";
                            enabled: root.cal-dirty;
                            clicked => { root.reset-calibration(); }
                        }
                    }

                    if !cal-section.expanded: Rectangle { height: 1px; background: #2a2a2a; }

                    // ── Color Mapping (collapsible) ──
                    color-match-section := SectionHeader {
                        title: "Color Mapping";
                        expanded: false;
                    }

                    if color-match-section.expanded: VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: root.color-match-status == "" ? "Measuring…" : root.color-match-status;
                            color: root.text-muted;
                            font-size: 10px;
                            wrap: word-wrap;
                        }

                        Tip {
                            tip: "Periodically measures each camera's color in the seam-adjacent band of its raw frame and nudges both toward their shared average, so an exposure/white-balance mismatch between the two cameras doesn't show up as a color step at the seam. Independent of geometric alignment. Only affects live YUV420P/NV12 decode paths.";
                            CheckBox {
                                text: "Auto color match";
                                checked <=> root.color-match-enabled;
                                toggled => { root.changed-color-match-enabled(self.checked); }
                            }
                        }

                        CalGroupBox {
                            title: "MEASUREMENT";

                            LabeledSlider {
                                tip: "Width of the seam-adjacent band sampled for the measurement, independent of the seam blend width. Updates live.";
                                label: "MEAS Band Width";
                                minimum: 0.02;
                                maximum: 1.0;
                                value <=> root.color-match-band-width;
                                decimals: 2;
                                step: 0.01;
                                changed(v) => { root.changed-color-match-band-width(v); }
                            }

                            LabeledSlider {
                                tip: "Re-measure color every N rendered frames. Updates live.";
                                label: "Measure interval";
                                minimum: 1;
                                maximum: 120;
                                value <=> root.color-match-interval-frames;
                                suffix: " frames";
                                decimals: 0;
                                step: 1;
                                changed(v) => { root.changed-color-match-interval-frames(v); }
                            }

                            LabeledSlider {
                                tip: "Sample grid columns per camera. More = a more stable measurement, at a small extra cost. Updates live.";
                                label: "Grid columns";
                                minimum: 2;
                                maximum: 32;
                                value <=> root.color-match-grid-cols;
                                decimals: 0;
                                step: 1;
                                changed(v) => { root.changed-color-match-grid-cols(v); }
                            }

                            LabeledSlider {
                                tip: "Sample grid rows per camera. Updates live.";
                                label: "Grid rows";
                                minimum: 2;
                                maximum: 64;
                                value <=> root.color-match-grid-rows;
                                decimals: 0;
                                step: 1;
                                changed(v) => { root.changed-color-match-grid-rows(v); }
                            }
                        }

                        CalGroupBox {
                            title: "CORRECTION LIMITS";

                            LabeledSlider {
                                tip: "Max luma (brightness) correction either camera can receive. Updates live.";
                                label: "Max Y offset";
                                minimum: 0;
                                maximum: 0.2;
                                value <=> root.color-match-max-y-offset;
                                decimals: 3;
                                step: 0.005;
                                changed(v) => { root.changed-color-match-max-y-offset(v); }
                            }

                            LabeledSlider {
                                tip: "Max color (chroma) correction either camera can receive. Updates live.";
                                label: "Max chroma offset";
                                minimum: 0;
                                maximum: 0.15;
                                value <=> root.color-match-max-chroma-offset;
                                decimals: 3;
                                step: 0.005;
                                changed(v) => { root.changed-color-match-max-chroma-offset(v); }
                            }

                            LabeledSlider {
                                tip: "How fast the correction reacts to a new measurement (higher = faster, noisier). Updates live.";
                                label: "Smoothing (EMA alpha)";
                                minimum: 0.01;
                                maximum: 1.0;
                                value <=> root.color-match-ema-alpha;
                                decimals: 2;
                                step: 0.01;
                                changed(v) => { root.changed-color-match-ema-alpha(v); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Tip {
                                tip: "Force a fresh color-match measurement against the current frame right now, instead of waiting for the next periodic remeasure - useful while paused, or right after seeking to a frame with different lighting.";
                                FlatButton {
                                    text: "Remeasure now";
                                    clicked => { root.remeasure-color-match(); }
                                }
                            }
                            FlatButton {
                                text: "Reset";
                                clicked => { root.reset-color-match(); }
                            }
                        }
                    }

                    if !color-match-section.expanded: Rectangle { height: 1px; background: #2a2a2a; }

                    // ── Auto-calibrate tuning (collapsible) ──
                    if root.has-both-videos: VerticalLayout {
                        spacing: 6px;

                        cal-advanced := SectionHeader {
                            title: "Advanced";
                            expanded: false;
                        }

                        if cal-advanced.expanded: VerticalLayout {
                            spacing: 10px;

                            CalGroupBox {
                                title: "SAMPLING";

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Frames:"; color: #888; font-size: 11px; vertical-alignment: center; }
                                    ComboBox {
                                        model: ["2", "4", "6", "8"];
                                        current-value: root.calibration-frames;
                                        width: 56px;
                                        enabled: !root.calibrating;
                                        selected(v) => { root.calibration-frames = max(2, v.to-float()); }
                                    }

                                    CheckBox {
                                        text: "IMU seeds";
                                        checked <=> root.use-imu-seeds;
                                        enabled: !root.calibrating;
                                    }
                                }

                                LabeledSlider {
                                    tip: "Seconds to skip at the end of the clip when sampling calibration frames.";
                                    label: "Skip end";
                                    minimum: 0;
                                    maximum: 60;
                                    value <=> root.cal-skip-end-secs;
                                    suffix: "s";
                                    decimals: 0;
                                    step: 1;
                                    changed(v) => {}
                                }
                            }

                            CalGroupBox {
                                title: "FEATURE DETECTION";

                                LabeledSlider {
                                    tip: "Feature detector sensitivity. Lower = more (weaker) features detected. Updates the preview live.";
                                    label: "AKAZE threshold";
                                    minimum: 0.00005;
                                    maximum: 0.005;
                                    value <=> root.cal-akaze-threshold;
                                    decimals: 4;
                                    step: 0.0001;
                                    changed(v) => { root.detect-preview-tick(); }
                                }

                                LabeledSlider {
                                    tip: "Top edge of the vertical region used for feature detection (fraction of frame height). Updates the preview live.";
                                    label: "Detect Y min";
                                    minimum: 0;
                                    maximum: 0.5;
                                    value <=> root.cal-detect-y-min;
                                    decimals: 2;
                                    step: 0.01;
                                    changed(v) => { root.detect-preview-tick(); }
                                }

                                LabeledSlider {
                                    tip: "Bottom edge of the vertical region used for feature detection (fraction of frame height). Updates the preview live.";
                                    label: "Detect Y max";
                                    minimum: 0.5;
                                    maximum: 1.0;
                                    value <=> root.cal-detect-y-max;
                                    decimals: 2;
                                    step: 0.01;
                                    changed(v) => { root.detect-preview-tick(); }
                                }

                                Tip {
                                    tip: "Detect features at full video resolution instead of downscaling to 1920px wide. More precise on 4K+ footage, but slower.";
                                    CheckBox {
                                        text: "Full-resolution features (slower)";
                                        checked <=> root.cal-full-res-features;
                                        enabled: !root.calibrating;
                                    }
                                }
                            }

                            CalGroupBox {
                                title: "ROTATION FIT";

                                Tip {
                                    tip: "Solve the right camera's independent pitch (x_rx), even without IMU data. Normally only auto-enabled when the IMU detects >2 deg differential pitch - cameras without a native gyro never get that seed. Try this if the two images still look rotated relative to each other after calibrating.";
                                    CheckBox {
                                        text: "Force extra rotation fit (x_rx)";
                                        checked <=> root.force-x-rx;
                                        enabled: !root.calibrating;
                                    }
                                }
                                Tip {
                                    tip: "Solve the left camera's independent roll (z_rz). There's no IMU signal for this angle, so it's always off unless checked here. Try this if the stitch still looks rotated after enabling Force extra rotation fit (x_rx).";
                                    CheckBox {
                                        text: "Force extra rotation fit (z_rz)";
                                        checked <=> root.force-z-rz;
                                        enabled: !root.calibrating;
                                    }
                                }
                            }

                            FlatButton {
                                text: "Reset AKAZE";
                                enabled: !root.calibrating;
                                clicked => {
                                    root.cal-akaze-threshold = 0.0001;
                                    root.cal-detect-y-min = 0.05;
                                    root.cal-detect-y-max = 0.95;
                                    root.cal-full-res-features = false;
                                    root.detect-preview-tick();
                                }
                            }
                        }
                    }

                    if root.has-both-videos: Rectangle { height: 1px; background: #2a2a2a; }

                    // ── Stats (collapsible, hidden in lens preview) ──
                    if !root.lens-preview-active: VerticalLayout {
                        spacing: 10px;

                    stats-section := SectionHeader {
                        title: "Stats";
                        expanded: false;
                    }

                    if stats-section.expanded: VerticalLayout {
                        spacing: 4px;

                        Text { text: "FPS: " + round(root.telem-fps-avg) + " avg / " + round(root.telem-fps-recent) + " recent"; color: #aaa; font-size: 11px; }
                        Text { text: "Frame: " + round(root.telem-total-ms * 10) / 10 + " / " + round(root.telem-p99-ms * 10) / 10 + " p99 ms"; color: #aaa; font-size: 11px; }
                        Text { text: "  Decode:   " + round(root.telem-decode-ms * 10) / 10 + " ms"; color: #888; font-size: 10px; }
                        Text { text: "  Stitch:   " + round(root.telem-stitch-ms * 10) / 10 + " ms"; color: #888; font-size: 10px; }
                        Text { text: "  Readback: " + round(root.telem-readback-ms * 10) / 10 + " ms"; color: #888; font-size: 10px; }
                        Text { text: "  Submit:   " + round(root.telem-submit-ms * 10) / 10 + " ms"; color: #888; font-size: 10px; }
                        if root.telem-bottleneck != "": Text { text: "Bottleneck: " + root.telem-bottleneck; color: #e8a060; font-size: 11px; font-weight: 600; }
                        if root.telem-gpu-name != "": Text { text: root.telem-gpu-name; color: #666; font-size: 10px; }
                        if root.telem-frames-dropped > 0: Text { text: "Dropped: " + root.telem-frames-dropped; color: #f88; font-size: 11px; }

                        Rectangle { height: 4px; }
                        Text { text: "Ball: " + round(root.telem-ball-pct) + "%  Tracks: " + root.telem-active-tracks + "  Det: " + round(root.telem-det-per-frame * 10) / 10 + "/f"; color: #aaa; font-size: 10px; }
                        if root.telem-detection-ms > 0: Text { text: "Detection: " + round(root.telem-detection-ms * 10) / 10 + " ms"; color: #aaa; font-size: 10px; }

                        if root.telem-cal-matches > 0: Rectangle { height: 4px; }
                        if root.telem-cal-matches > 0: Text { text: "Cal: " + round(root.telem-cal-confidence * 100) + "% conf, " + root.telem-cal-matches + " matches, reproj " + round(root.telem-cal-reproj-err * 10000) / 10000; color: #aaa; font-size: 10px; }
                    }
                    }  // close stats wrapper (lens-preview gate)
                }
                }  // close ScrollView
            }

        }

        // ── Transport bar: full-width scrubber row, then a control row
        // with three balanced zones (playhead info / transport buttons /
        // recording+format) separated by thin dividers. The content is
        // inset to line up with the preview column above it (not the
        // side panels), but the bar's own background still spans the
        // full width so there's no color seam under the side panels. ──
        Rectangle {
            // padding-top(4) + scrubber row(20) + spacing(4) +
            // control row(36) + padding-bottom(4) = 68px content height;
            // 70px leaves a couple px of slack instead of sitting right at
            // the edge. Too little here and the control row (frame field,
            // buttons, Rec/format controls) overflows into the status bar
            // below it instead of clipping or reflowing. Control row is
            // 36px (not 24px) to fit the "FRAME" caption under the frame
            // number field.
            height: 70px;
            background: root.bg-bar;

            Rectangle {
                x: preview-column.x;
                width: preview-column.width;
                height: 100%;

            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 4px;

                // ── Scrubber row: current time, timeline, total time ──
                HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: root.current-time-text;
                        color: #aaa;
                        font-size: 11px;
                        vertical-alignment: center;
                        width: 56px;
                        horizontal-alignment: right;
                    }

                    scrubber-track := Rectangle {
                        horizontal-stretch: 1;
                        height: 20px;

                        // Export range indicator (green tint behind the slider)
                        if root.export-start-secs > 0 || root.export-end-secs < root.clip-duration-secs: Rectangle {
                            property <float> start-frac: root.clip-duration-secs > 0
                                ? root.export-start-secs / root.clip-duration-secs : 0;
                            property <float> end-frac: root.clip-duration-secs > 0
                                ? root.export-end-secs / root.clip-duration-secs : 1.0;

                            x: parent.width * start-frac;
                            width: parent.width * (end-frac - start-frac);
                            height: parent.height;
                            background: #4a7a4a33;
                            border-radius: 2px;
                        }

                        Slider {
                            width: 100%;
                            minimum: 0;
                            maximum: root.total-frames == 0 ? 1.0 : 1.0 * root.total-frames;
                            value: 1.0 * root.current-frame;
                            enabled: root.files-loaded;
                            released(val) => {
                                if root.total-frames > 0 { root.seek(val / root.total-frames); }
                            }
                        }

                        // Cut-range bands (reddish, draggable) - drawn on top
                        // of the slider so their handles/body stay grabbable;
                        // this deliberately shadows click-to-seek under a
                        // band, same trade-off ordinary video editors make
                        // for in/out markers on the scrubber.
                        for range[i] in root.cut-ranges: Rectangle {
                            // Local live-drag preview - only committed to
                            // Rust (root.cut-range-update) on release, so a
                            // drag in progress never round-trips through the
                            // model/rebuild cycle on every mouse move.
                            property <float> preview-start: range.start-secs;
                            property <float> preview-end: range.end-secs;
                            // Captured from `parent` (scrubber-track, our
                            // direct parent) rather than a named
                            // cross-reference to `scrubber-track` itself -
                            // matches the export-range indicator's own
                            // `parent.width` use just above. A named
                            // self-reference from inside this `for` loop
                            // left the whole scrubber unsized on the first
                            // layout pass (only a later reactive update,
                            // e.g. cut-ranges itself changing, forced the
                            // relayout that made it appear) - found by the
                            // user, not assumed.
                            property <length> track-width: parent.width;
                            property <float> start-frac: root.clip-duration-secs > 0
                                ? preview-start / root.clip-duration-secs : 0;
                            property <float> end-frac: root.clip-duration-secs > 0
                                ? preview-end / root.clip-duration-secs : 0;

                            x: track-width * start-frac;
                            width: max(4px, track-width * (end-frac - start-frac));
                            height: parent.height;
                            background: cut-body.has-hover ? #d9503aa0 : #cc4a3380;
                            border-width: 1px;
                            border-color: #ffffff40;
                            border-radius: 2px;
                            clip: false;

                            cut-body := TouchArea {
                                mouse-cursor: self.pressed ? grabbing : grab;
                                moved => {
                                    if self.pressed && track-width > 0px {
                                        preview-start = max(0,
                                            range.start-secs + (self.mouse-x - self.pressed-x) / track-width * root.clip-duration-secs);
                                        preview-end = preview-start + (range.end-secs - range.start-secs);
                                    }
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.up) {
                                        root.cut-range-update(i, preview-start, preview-end);
                                    }
                                }
                            }

                            Rectangle {
                                x: 0px;
                                width: 5px;
                                height: parent.height;
                                background: #ffffff90;
                                left-handle-touch := TouchArea {
                                    mouse-cursor: ew-resize;
                                    moved => {
                                        if self.pressed && track-width > 0px {
                                            preview-start = max(0, min(
                                                range.start-secs + (self.mouse-x - self.pressed-x) / track-width * root.clip-duration-secs,
                                                preview-end - 0.2));
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.up) {
                                            root.cut-range-update(i, preview-start, preview-end);
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                x: parent.width - 5px;
                                width: 5px;
                                height: parent.height;
                                background: #ffffff90;
                                right-handle-touch := TouchArea {
                                    mouse-cursor: ew-resize;
                                    moved => {
                                        if self.pressed && track-width > 0px {
                                            preview-end = min(root.clip-duration-secs, max(
                                                range.end-secs + (self.mouse-x - self.pressed-x) / track-width * root.clip-duration-secs,
                                                preview-start + 0.2));
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.up) {
                                            root.cut-range-update(i, preview-start, preview-end);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: root.total-time-text;
                        color: #666;
                        font-size: 11px;
                        vertical-alignment: center;
                        width: 56px;
                    }
                }

                // ── Control row: playhead info (left) / transport buttons
                // (true-centered) / recording + format (right), divided by
                // thin translucent-white rules - same convention as the
                // audio-waveform grid lines above.
                control-row := Rectangle {
                    height: 36px;

                    left-zone := HorizontalLayout {
                        x: 0px;
                        width: self.preferred-width;
                        height: parent.height;
                        spacing: 10px;

                        // Plain-Text/LineEdit swap (not a single persistent
                        // LineEdit bound to `current-frame`): Slint's
                        // built-in text widgets break a one-way `text:
                        // expr` binding the moment the user types into
                        // them, so a persistent LineEdit here would
                        // permanently stop reflecting the playhead after
                        // the first edit. Re-instantiating on each edit
                        // (like LabeledSlider) gives a fresh binding every
                        // time instead.
                        //
                        // Not wrapped in `Tip`: `Tip` owns a hover-
                        // triggered `PopupWindow` that only closes via its
                        // own `changed has-hover` binding. Wrapping this
                        // toggleable region orphans that popup permanently
                        // on-screen, because clicking to enter edit mode
                        // destroys the `Tip` instance (and its hover
                        // binding) while the popup is still showing, so
                        // `popup.close()` never runs.
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            if !root.frame-input-editing: TouchArea {
                                mouse-cursor: pointer;
                                // TouchArea doesn't auto-size to its child
                                // within a layout - without an explicit width
                                // this collapses to ~0px, silently hiding the
                                // field.
                                width: 60px;
                                height: 22px;
                                clicked => { root.frame-input-editing = true; }
                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    background: root.bg-panel;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: #444;
                                    Text {
                                        text: root.current-frame;
                                        color: white;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                            }
                            if root.frame-input-editing: HorizontalLayout {
                                frame-input := NumEdit {
                                    text: root.current-frame;
                                    width: 60px;
                                    height: 22px;
                                    enabled: root.files-loaded;
                                    num-font-size: 11px;
                                    function commit() {
                                        if root.total-frames > 0 {
                                            root.seek(clamp(self.text.to-float(), 0.0, 1.0 * (root.total-frames - 1)) / root.total-frames);
                                        }
                                        root.frame-input-editing = false;
                                    }
                                    accepted => { self.commit(); }
                                    escaped => { root.frame-input-editing = false; }
                                    changed has-focus => {
                                        if !self.has-focus && root.frame-input-editing {
                                            self.commit();
                                        }
                                    }
                                }
                                // Deferred focus: focusing synchronously from
                                // `init` (mid-layout-pass, since this branch
                                // was just mounted by the `if` toggle above)
                                // hits a Slint "Recursion detected" panic -
                                // see the same pattern on `LabeledSlider`'s
                                // edit-mode field.
                                frame-focus-timer := Timer {
                                    interval: 1ms;
                                    running: true;
                                    triggered => {
                                        self.running = false;
                                        frame-input.focus();
                                        frame-input.select-all();
                                    }
                                }
                            }

                            Text {
                                text: "FRAME #";
                                color: #666;
                                font-size: 8px;
                                font-weight: 600;
                                letter-spacing: 0.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 60px;
                            }
                        }

                    }

                    // Divider between the playhead-info zone and the
                    // transport buttons.
                    Rectangle {
                        x: left-zone.x + left-zone.width + 8px;
                        y: 1px;
                        width: 1px;
                        height: parent.height - 2px;
                        background: #ffffff22;
                    }

                    // Playback buttons: jump-to-start / step-back /
                    // play-pause / step-forward / stop (pause-in-place) /
                    // jump-to-end - matches the reference NLE-style
                    // transport bar. True-centered on the row (not just
                    // stretch-centered), same as the timeline above it,
                    // regardless of how wide the left/right zones are.
                    center-zone := HorizontalLayout {
                        x: (parent.width - self.width) / 2;
                        width: self.preferred-width;
                        height: parent.height;
                        spacing: 2px;
                        Tip { tip: "Jump to first frame."; TransportButton { text: "|<"; enabled: root.files-loaded; clicked => { root.seek(0.0); } } }
                        Tip { tip: "Step back one frame."; TransportButton { text: "<"; enabled: root.files-loaded; clicked => { root.step-backward(); } } }
                        Tip { tip: "Play or pause."; TransportButton { text: root.playing ? "||" : "▶"; emphasized: true; enabled: root.files-loaded; clicked => { root.toggle-playback(); } } }
                        Tip { tip: "Step forward one frame."; TransportButton { text: ">"; enabled: root.files-loaded; clicked => { root.step-forward(); } } }
                        Tip { tip: "Stop (pause in place)."; TransportButton { text: "■"; enabled: root.files-loaded; clicked => { root.pause-playback(); } } }
                        Tip { tip: "Jump to last frame."; TransportButton { text: ">|"; enabled: root.files-loaded; clicked => { root.seek(1.0); } } }
                    }

                    // Divider between the transport buttons and the
                    // recording/format zone.
                    Rectangle {
                        x: right-zone.x - 8px - 1px;
                        y: 1px;
                        width: 1px;
                        height: parent.height - 2px;
                        background: #ffffff22;
                    }

                    right-zone := HorizontalLayout {
                        x: parent.width - self.width;
                        width: self.preferred-width;
                        height: parent.height;
                        spacing: 8px;

                        // Playback speed multiplier, placed just before the
                        // Rec button. Same click-to-edit swap as
                        // LabeledSlider's value field: a LineEdit
                        // permanently bound one-way to an externally-
                        // updated value (e.g. resynced to 1.0x on loading
                        // a new clip) would stop reflecting it the moment
                        // the user types into it.
                        HorizontalLayout {
                            spacing: 3px;
                            Tip {
                                tip: "Playback speed multiplier. Click the box to type an exact value.";
                                Text { text: "Speed:"; color: #777; font-size: 10px; vertical-alignment: center; }
                            }
                            if !root.speed-input-editing: TouchArea {
                                mouse-cursor: pointer;
                                width: 40px;
                                height: 20px;
                                clicked => { root.speed-input-editing = true; }
                                Rectangle {
                                    width: 100%;
                                    height: 25px;
                                    background: root.bg-panel;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: #444;

                                    Text {
                                        text: root.playback-speed;
                                        color: white;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 50px;
                                        height: 100%;
                                    }
                                }
                            }
                            if root.speed-input-editing: HorizontalLayout {
                                speed-input := NumEdit {
                                    text: root.playback-speed;
                                    width: 40px;
                                    height: 20px;
                                    enabled: root.files-loaded;
                                    num-font-size: 11px;
                                    function commit() {
                                        root.playback-speed = self.text.to-float();
                                        root.changed-playback-speed(root.playback-speed);
                                        root.speed-input-editing = false;
                                    }
                                    accepted => { self.commit(); }
                                    escaped => { root.speed-input-editing = false; }
                                    changed has-focus => {
                                        if !self.has-focus && root.speed-input-editing {
                                            self.commit();
                                        }
                                    }
                                }
                                speed-focus-timer := Timer {
                                    interval: 1ms;
                                    running: true;
                                    triggered => {
                                        self.running = false;
                                        speed-input.focus();
                                        speed-input.select-all();
                                    }
                                }
                            }
                            Text { text: "x"; color: #777; font-size: 10px; vertical-alignment: center; }
                        }

                        // Record button
                        Rectangle {
                            width: rec-layout.preferred-width + 12px;
                            border-radius: 5px;
                            background: root.recording ? #4a1010 : rec-touch.has-hover ? #3a2020 : #2a1a1a;
                            border-width: 1px;
                            border-color: root.recording ? #e04040 : #553333;
                            rec-touch := TouchArea {
                                enabled: root.files-loaded && !root.export-in-progress;
                                clicked => { root.toggle-recording(root.recording-codec, root.recording-quality); }
                            }
                            rec-layout := HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                Rectangle { width: 7px; height: 7px; y: (parent.height - self.height) / 2; border-radius: 4px; background: root.recording ? #ff3030 : #883030; }
                                Text { text: root.recording ? "Stop" : "Rec*"; color: root.recording ? #ff6060 : #cc8888; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                            }
                        }

                        if !root.recording: ComboBox {
                            model: ["fast", "balanced", "high"];
                            current-value <=> root.recording-quality;
                            enabled: root.files-loaded && !root.export-in-progress;
                            width: 82px;
                        }

                        ComboBox {
                            model: ["auto", "16:9", "4:3", "21:9"];
                            current-value <=> root.preview-aspect;
                            enabled: root.files-loaded;
                            width: 78px;
                            selected(v) => { root.changed-preview-aspect(v); }
                        }
                    }
                }
            }
            }
        }

        // ── Status bar (or export progress when active) ──
        Rectangle {
            background: root.bg-bar;
            min-height: 20px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                if !root.export-in-progress: Text {
                    text: root.status-text;
                    color: #666;
                    font-size: 11px;
                    vertical-alignment: center;
                    // Status bar is the primary error channel (toasts are
                    // broken), so long failure messages must stay readable:
                    // wrap onto extra lines instead of clipping the tail.
                    wrap: word-wrap;
                    horizontal-stretch: 1;
 Rectangle { min-width: 16px; min-height: 16px; /* @lsp:ignore-node */ }                }

                if root.export-in-progress: Text {
                    text: "Exporting: " + root.export-status-text;
                    color: #8f8;
                    font-size: 11px;
                    vertical-alignment: center;
                    font-weight: 600;
                }

                if root.export-in-progress: ProgressIndicator {
                    progress: root.export-progress;
                    min-width: 120px;
                    horizontal-stretch: 1;
                }

                if root.export-in-progress: FlatButton {
                    text: "Cancel";
                    clicked => { root.cancel-export(); }
                }

                if !root.export-in-progress && root.last-output-path != "": FlatButton {
                    text: "Show in folder";
                    clicked => { root.show-in-folder(root.last-output-path); }
                }

                if !root.export-in-progress && root.telem-fps-avg > 0: Text {
                    text: round(root.telem-fps-avg) + " / " + round(root.telem-fps-recent) + " fps";
                    color: #555;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                if root.version != "": Text {
                    text: root.version;
                    color: #444;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: bug-btn-layout.preferred-width + 10px;
                    height: 20px;
                    border-radius: 3px;
                    background: bug-touch.has-hover ? #333 : transparent;
                    bug-btn-layout := HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        spacing: 4px;
                        Text { text: "Report Bug"; color: #666; font-size: 10px; vertical-alignment: center; }
                    }
                    bug-touch := TouchArea {
                        clicked => { root.bug-dialog-open = true; }
                    }
                }
            }
        }
        }  // close VerticalBox

        // ── Recent files dialog (modal) ──
        // Three columns (Left / Right / Calibration). Each entry is a
        // clickable row; click loads that path into the corresponding
        // file slot. Rendered as a sibling of the main layout so it
        // overlays everything.
        if root.recent-dialog-open: Rectangle {
            background: root.bg-scrim;
            TouchArea {
                clicked => { root.recent-dialog-open = false; }
            }

            Rectangle {
                width: 720px;
                height: 460px;
                background: root.bg-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.border-mid;
                // Block click-through so clicks inside the panel do
                // not close the dialog.
                TouchArea {}

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Recent files";
                            color: #fff;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        FlatButton {
                            text: "Clear all";
                            clicked => {
                                root.clear-recent-files();
                                root.recent-dialog-open = false;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        padding: 0;
                        vertical-stretch: 1;

                        // Three column wrappers share the same structure
                        // so the styling stays consistent.
                        Rectangle {
                            border-radius: 6px;
                            background: root.bg-panel;
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: "Left videos";
                                    color: #aaa;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                ScrollView {
                                    VerticalLayout {
                                        spacing: 2px;
                                        for entry in root.recent-left-paths: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: row-l.has-hover ? #2d2d2d : transparent;
                                            Text {
                                                text: entry;
                                                color: #ccc;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                x: 6px;
                                                width: parent.width - 12px;
                                            }
                                            row-l := TouchArea {
                                                clicked => {
                                                    root.load-recent-left(entry);
                                                    root.recent-dialog-open = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 6px;
                            background: root.bg-panel;
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: "Right videos";
                                    color: #aaa;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                ScrollView {
                                    VerticalLayout {
                                        spacing: 2px;
                                        for entry in root.recent-right-paths: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: row-r.has-hover ? #2d2d2d : transparent;
                                            Text {
                                                text: entry;
                                                color: #ccc;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                x: 6px;
                                                width: parent.width - 12px;
                                            }
                                            row-r := TouchArea {
                                                clicked => {
                                                    root.load-recent-right(entry);
                                                    root.recent-dialog-open = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 6px;
                            background: root.bg-panel;
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: "Calibrations";
                                    color: #aaa;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                ScrollView {
                                    VerticalLayout {
                                        spacing: 2px;
                                        for entry in root.recent-calibration-paths: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: row-c.has-hover ? #2d2d2d : transparent;
                                            Text {
                                                text: entry;
                                                color: #ccc;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                x: 6px;
                                                width: parent.width - 12px;
                                            }
                                            row-c := TouchArea {
                                                clicked => {
                                                    root.load-recent-calibration(entry);
                                                    root.recent-dialog-open = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        FlatButton {
                            text: "Close";
                            clicked => { root.recent-dialog-open = false; }
                        }
                    }
                }
            }
        }

        // ── Keyboard shortcuts dialog (modal) ──
        if root.shortcuts-dialog-open: Rectangle {
            background: root.bg-scrim;
            TouchArea {
                clicked => { root.shortcuts-dialog-open = false; }
            }

            Rectangle {
                width: 420px;
                height: 360px;
                background: root.bg-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.border-mid;
                TouchArea {}

                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;

                    Text {
                        text: "Keyboard shortcuts";
                        color: root.text-heading;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    Rectangle { height: 1px; background: root.border-subtle; }

                    // Explicit two-column rows for alignment: the key
                    // column is fixed width, the description fills.
                    for row in [
                        { k: "Space", v: "Play / pause" },
                        { k: "Arrows", v: "Pan camera (hold) or step 1 frame (with playback paused)" },
                        { k: "+  /  -", v: "Zoom in / out" },
                        { k: "Scroll", v: "Zoom in / out" },
                        { k: "Drag", v: "Pan preview with mouse" },
                        { k: "[  /  ]", v: "Seek backward / forward 5 seconds" },
                        { k: "R", v: "Reset camera view (yaw, pitch, FOV)" },
                    ]: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: row.k;
                            color: #a0e8a0;
                            font-size: 12px;
                            font-weight: 600;
                            width: 80px;
                        }
                        Text {
                            text: row.v;
                            color: #ccc;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Rectangle { height: 1px; background: root.border-subtle; }

                    HorizontalLayout {
                        spacing: 8px;
                        FlatButton { text: "Website"; clicked => { root.open-website(); } }
                        FlatButton { text: "Forum"; clicked => { root.open-forum(); } }
                        Rectangle { horizontal-stretch: 1; }
                        FlatButton {
                            text: "Close";
                            clicked => { root.shortcuts-dialog-open = false; }
                        }
                    }
                }
            }
        }

        // ── Preferences dialog (modal) ──
        //
        // Editable subset of GuiSettings: default export codec,
        // default quality, default blend width, AI model path. Save
        // persists; Cancel discards.
        if root.prefs-dialog-open: Rectangle {
            background: root.bg-scrim;
            TouchArea {
                clicked => { root.prefs-dialog-open = false; }
            }

            Rectangle {
                width: 480px;
                height: min(parent.height - 60px, 680px);
                background: root.bg-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.border-mid;
                TouchArea {}

                ScrollView {
                    horizontal-scrollbar-policy: always-off;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: "Preferences";
                        color: root.text-heading;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    Rectangle { height: 1px; background: root.border-subtle; }

                    Tip {
                        tip: "Codec used to prefill the Export dialog. Can still be changed per export.";
                        Text { text: "Default codec"; color: #ccc; font-size: 12px; }
                    }
                    ComboBox {
                        model: root.available-codecs;
                        current-value <=> root.prefs-default-codec;
                    }

                    Tip {
                        tip: "Quality preset used to prefill the Export dialog. Can still be changed per export.";
                        Text { text: "Default quality"; color: #ccc; font-size: 12px; }
                    }
                    ComboBox {
                        model: ["fast", "balanced", "high"];
                        current-value <=> root.prefs-default-quality;
                    }

                    Tip {
                        tip: "Seam blend width used to prefill new calibrations - matches the Stitching panel's Seam blend slider.";
                        Text {
                            text: "Default seam blend (" + round(root.prefs-default-blend-width * 100) / 100 + ")";
                            color: #ccc;
                            font-size: 12px;
                        }
                    }
                    Slider {
                        minimum: 0;
                        maximum: 0.3;
                        value <=> root.prefs-default-blend-width;
                    }

                    Tip {
                        tip: "Default YOLO model path, used to prefill the Export dialog's AI Tracking section so you don't have to browse for it every time.";
                        Text { text: "AI model (ONNX)"; color: #ccc; font-size: 12px; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.prefs-ai-model-path;
                            placeholder-text: "Path to .onnx, or leave empty";
                            horizontal-stretch: 1;
                        }
                        FlatButton {
                            text: "Browse…";
                            clicked => { root.pick-prefs-model(); }
                        }
                    }

                    Tip {
                        tip: "Calibration file used as a fallback whenever no calibration is otherwise loaded for a session. Saving over this file while it's your active calibration will ask for confirmation first, since future sessions with nothing else picked fall back to it.";
                        Text { text: "Default calibration"; color: #ccc; font-size: 12px; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.prefs-default-calibration-path;
                            placeholder-text: "Path to .json, or leave empty";
                            horizontal-stretch: 1;
                        }
                        FlatButton {
                            text: "Browse…";
                            clicked => { root.pick-prefs-default-calibration(); }
                        }
                    }

                    Rectangle { height: 1px; background: root.border-subtle; }

                    Text { text: "Recording defaults"; color: #ccc; font-size: 12px; font-weight: 600; }

                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Tip {
                                tip: "Codec for live-preview recordings (the record button in the transport bar) - separate from the Export dialog's codec.";
                                Text { text: "Codec"; color: #ccc; font-size: 12px; }
                            }
                            ComboBox {
                                model: root.available-codecs;
                                current-value <=> root.recording-codec;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Tip {
                                tip: "Quality for live-preview recordings - separate from the Export dialog's quality.";
                                Text { text: "Quality"; color: #ccc; font-size: 12px; }
                            }
                            ComboBox {
                                model: ["fast", "balanced", "high"];
                                current-value <=> root.recording-quality;
                            }
                        }
                    }

                    Tip {
                        tip: "Where live-preview recordings are saved. Empty = same folder as the source video.";
                        Text { text: "Recording folder"; color: #ccc; font-size: 12px; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.recording-folder;
                            placeholder-text: "Same as source video (default)";
                            horizontal-stretch: 1;
                        }
                        FlatButton {
                            text: "Browse…";
                            clicked => { root.pick-recording-folder(); }
                        }
                    }

                    Rectangle { height: 1px; background: root.border-subtle; }

                    Text { text: "Appearance"; color: root.text-body; font-size: 12px; font-weight: 600; }

                    Tip {
                        tip: "Switch the app between dark and light theme.";
                        CheckBox {
                            text: "Dark mode";
                            checked <=> root.prefs-dark-mode;
                        }
                    }

                    Rectangle { height: 1px; background: root.border-subtle; }

                    Text { text: "Privacy"; color: root.text-body; font-size: 12px; font-weight: 600; }

                    CheckBox {
                        text: "Send anonymous usage data (opt-in)";
                        checked <=> root.prefs-telemetry-enabled;
                    }
                    Text {
                        text: "Helps improve Reco. Shares system info and performance data.";
                        color: #666;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 1px; background: root.border-subtle; }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        FlatButton {
                            text: "Cancel";
                            clicked => { root.prefs-dialog-open = false; }
                        }
                        FlatButton {
                            text: "Save";
                            primary: true;
                            clicked => {
                                root.save-prefs();
                                root.prefs-dialog-open = false;
                            }
                        }
                    }
                }
                }  // close ScrollView
            }
        }

        // ── Bug report dialog ──
        if root.bug-dialog-open: Rectangle {
            background: root.bg-scrim;
            TouchArea { clicked => { root.bug-dialog-open = false; } }

            Rectangle {
                width: 500px;
                height: min(parent.height - 60px, 420px);
                background: root.bg-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.border-mid;
                TouchArea {}

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    Text { text: "Report a Bug"; color: root.text-heading; font-size: 18px; font-weight: 600; }

                    Text {
                        text: "Tell us what happened. Your system info (GPU, OS, settings) will be included to help us fix the issue faster.";
                        color: root.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Text { text: "What went wrong?"; color: root.text-body; font-size: 12px; }
                    bug-msg := LineEdit {
                        placeholder-text: "e.g. The video freezes when I click Export";
                    }

                    Text { text: "How can we reach you? (optional)"; color: root.text-body; font-size: 12px; }
                    bug-contact := LineEdit {
                        text <=> root.bug-user-contact;
                        placeholder-text: "Forum username or email";
                    }

                    bug-share-logs := CheckBox {
                        text: "Include system info and logs";
                        checked: true;
                    }
                    Text {
                        text: "Shares GPU model, OS, performance stats, and logs. No video content is sent.";
                        color: root.text-dim;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        FlatButton { text: "Cancel"; clicked => { root.bug-dialog-open = false; } }
                        FlatButton {
                            text: "Send Report";
                            primary: true;
                            enabled: bug-msg.text != "";
                            clicked => {
                                root.submit-bug-report(bug-msg.text, bug-contact.text, bug-share-logs.checked);
                                root.bug-dialog-open = false;
                            }
                        }
                    }
                }
            }
        }

        // Toast stack moved outside VerticalLayout (see below).

        // ── Export dialog (modal overlay) ──
        //
        // Placed as a sibling of the main VerticalBox so it renders on
        // top. Visibility toggled by `export-dialog-open`. Clicks on
        // the dark backdrop outside the panel dismiss the dialog.
        if root.export-dialog-open: Rectangle {
            background: root.bg-scrim; // 67% opacity scrim
            TouchArea {
                // Swallow clicks on the backdrop; clicking a transparent
                // area (not the panel) closes the dialog.
                clicked => { root.export-dialog-open = false; }
            }

            Rectangle {
                width: 560px;
                height: min(parent.height - 60px, 720px);
                background: root.bg-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.border-mid;

                TouchArea {}

                ScrollView {
                    horizontal-scrollbar-policy: always-off;

                VerticalBox {
                    padding: 24px;
                    spacing: 14px;

                    Text {
                        text: "Export Stitched Video";
                        color: #fff;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    Text {
                        text: "Run the full pipeline (decode → stitch → encode) and save the output.";
                        color: #999;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // Output path
                    Tip {
                        tip: "Destination for the stitched export. Type a path directly or browse - whatever's here when you click Start Export is used verbatim.";
                        Text { text: "Output file"; color: #ccc; font-size: 12px; }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        padding: 0;
                        // Editable: users want to rename the suggested
                        // file without invoking the file dialog every
                        // time. Rust reads `export-output-path` verbatim
                        // when Start Export fires, so whatever is typed
                        // here is what gets written.
                        LineEdit {
                            text <=> root.export-output-path;
                            placeholder-text: "Pick a destination file, or type a path…";
                            horizontal-stretch: 1;
                        }
                        FlatButton {
                            text: "Save to…";
                            clicked => { root.pick-export-output(); }
                        }
                    }

                    // Resolution presets
                    HorizontalBox {
                        spacing: 10px;
                        padding: 0;

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Tip {
                                tip: "Output resolution for the stitched video. Independent of the source cameras' resolution.";
                                Text { text: "Resolution"; color: #ccc; font-size: 12px; }
                            }
                            ComboBox {
                                model: ["1080p (1920x1080)", "720p (1280x720)", "2K (2560x1440)", "4K (3840x2160)"];
                                current-index: root.export-width == 1280 ? 1
                                             : root.export-width == 2560 ? 2
                                             : root.export-width == 3840 ? 3
                                             : 0;
                                selected(v) => {
                                    if (v == "720p (1280x720)") {
                                        root.export-width = 1280;
                                        root.export-height = 720;
                                    } else if (v == "2K (2560x1440)") {
                                        root.export-width = 2560;
                                        root.export-height = 1440;
                                    } else if (v == "4K (3840x2160)") {
                                        root.export-width = 3840;
                                        root.export-height = 2160;
                                    } else {
                                        root.export-width = 1920;
                                        root.export-height = 1080;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: root.export-width + " x " + root.export-height; color: #888; font-size: 11px; }
                        }
                    }

                    HorizontalBox {
                        spacing: 10px;
                        padding: 0;

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Tip {
                                tip: "Video codec for the export. Falls back automatically (hardware -> software) if a specific encoder can't be opened on this machine - check the Debug log for which one was actually used.";
                                Text { text: "Codec"; color: #ccc; font-size: 12px; }
                            }
                            ComboBox {
                                model: root.available-codecs;
                                current-index: root.export-codec == "hevc" ? 1
                                             : root.export-codec == "av1" ? 2
                                             : 0;
                                selected(v) => { root.export-codec = v; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Tip {
                                tip: "Encoder quality preset - trades encode speed and file size for visual quality.";
                                Text { text: "Quality"; color: #ccc; font-size: 12px; }
                            }
                            ComboBox {
                                model: ["fast", "balanced", "high"];
                                current-index: root.export-quality == "fast" ? 0
                                             : root.export-quality == "high" ? 2
                                             : 1;
                                selected(v) => { root.export-quality = v; }
                            }
                        }
                    }

                    // Processing range (start/end with sliders and manual input)
                    Tip {
                        tip: "Trims the export to a start/end time window within the loaded clip. Defaults to the full clip.";
                        Text { text: "Processing range"; color: #ccc; font-size: 12px; }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        padding: 0;

                        VerticalLayout {
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Tip {
                                tip: "Export start time, in seconds from the beginning of the clip.";
                                Text { text: "Start (s)"; color: #888; font-size: 11px; }
                            }
                            Slider {
                                minimum: 0;
                                maximum: max(1, root.clip-duration-secs);
                                value <=> root.export-start-secs;
                                enabled: root.clip-duration-secs > 0;
                                changed(v) => {
                                    if v > root.export-end-secs { root.export-start-secs = root.export-end-secs; }
                                }
                            }
                            NumEdit {
                                text: root.export-start-secs == 0 ? "" : root.export-start-secs;
                                placeholder-text: "0:00";
                                edited(v) => {
                                    root.export-start-secs = Math.min(max(0, v.to-float()), root.export-end-secs);
                                }
                                escaped => { self.text = root.export-start-secs == 0 ? "" : root.export-start-secs; }
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Tip {
                                tip: "Export end time, in seconds from the beginning of the clip.";
                                Text { text: "End (s)"; color: #888; font-size: 11px; }
                            }
                            Slider {
                                minimum: 0;
                                maximum: max(1, root.clip-duration-secs);
                                value <=> root.export-end-secs;
                                enabled: root.clip-duration-secs > 0;
                                changed(v) => {
                                    if v < root.export-start-secs { root.export-end-secs = root.export-start-secs; }
                                }
                            }
                            NumEdit {
                                text: root.export-end-secs;
                                edited(v) => {
                                    root.export-end-secs = Math.max(Math.min(v.to-float(), root.clip-duration-secs), root.export-start-secs);
                                }
                                escaped => { self.text = root.export-end-secs; }
                            }
                        }
                    }

                    Text {
                        property <float> range-dur: root.export-end-secs - root.export-start-secs;
                        text: range-dur <= 0
                            ? "Duration: 0s (nothing to export)"
                            : "Duration: " + round(range-dur * 10) / 10 + "s";
                        color: range-dur <= 0 ? #ff6666 : #888;
                        font-size: 11px;
                    }

                    // Cut ranges: exclude sub-windows from the export (e.g.
                    // a halftime pause). Drag bands directly on the
                    // scrubber above for a quick mark, or add/adjust/remove
                    // precisely here - both drive the same
                    // root.cut-range-* callbacks.
                    HorizontalLayout {
                        spacing: 6px;
                        Tip {
                            tip: "Excludes a time range from the export, splicing what remains back together with no gap. Drag the reddish band on the scrubber above, or use \"+ Add cut\" and edit the numbers here.";
                            Text { text: "Cut ranges"; color: #ccc; font-size: 12px; vertical-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        FlatButton {
                            text: "+ Add cut";
                            clicked => { root.cut-range-add(); }
                        }
                    }

                    for range[i] in root.cut-ranges: HorizontalBox {
                        padding: 0;
                        spacing: 6px;
                        NumEdit {
                            text: range.start-secs;
                            width: 64px;
                            edited(v) => { root.cut-range-update(i, v.to-float(), range.end-secs); }
                            escaped => { self.text = range.start-secs; }
                        }
                        Text { text: "-"; color: #888; vertical-alignment: center; }
                        NumEdit {
                            text: range.end-secs;
                            width: 64px;
                            edited(v) => { root.cut-range-update(i, range.start-secs, v.to-float()); }
                            escaped => { self.text = range.end-secs; }
                        }
                        Text {
                            text: round((range.end-secs - range.start-secs) * 10) / 10 + "s";
                            color: #666;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 5px;
                            background: cut-rm.has-hover ? #331516 : transparent;
                            Text { text: "×"; color: cut-rm.has-hover ? #ff6b6b : #6a7077; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                            cut-rm := TouchArea { clicked => { root.cut-range-remove(i); } }
                        }
                    }

                    Tip {
                        tip: "Also saves the raw pre-stitch source frames (stacked side-by-side) to a separate file alongside the export, for later re-stitching without re-decoding the originals.";
                        CheckBox {
                            text: "Record replay (stacked raw input for re-stitching)";
                            checked <=> root.export-replay-enabled;
                        }
                    }

                    Tip {
                        tip: "Writes every detection, filter decision, and pan decision to a .jsonl file next to the export, for offline analysis with visualize_detections.py.";
                        CheckBox {
                            text: "Save AI debug events (.jsonl for visualize_detections.py)";
                            checked <=> root.export-events-enabled;
                        }
                    }

                    Rectangle { height: 1px; background: root.border-subtle; }

                    // AI Tracking section
                    HorizontalBox {
                        padding: 0;
                        spacing: 8px;
                        Text {
                            text: "AI Tracking";
                            color: #fff;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Tip {
                            tip: "Turns on AI camera tracking (ball/player detection) for this export. Needs a YOLO ONNX model below.";
                            CheckBox {
                                text: "Enable";
                                checked <=> root.export-autocam-enabled;
                                enabled: root.ai-available;
                            }
                        }
                    }

                    Text {
                        text: root.ai-status;
                        color: root.ai-available ? #8f8 : #f88;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if root.export-autocam-enabled: VerticalLayout {
                        spacing: 8px;

                        HorizontalBox {
                            spacing: 6px;
                            padding: 0;
                            LineEdit {
                                text: root.export-model-path;
                                placeholder-text: "Pick a YOLO ONNX model…";
                                read-only: true;
                                horizontal-stretch: 1;
                            }
                            FlatButton {
                                text: "Model…";
                                clicked => { root.pick-export-model(); }
                            }
                        }

                        // AI is enabled but no model picked: without one the
                        // detector never attaches and the export silently
                        // produces no tracking. Warn and block Start below.
                        if root.export-model-path == "": Text {
                            text: "⚠ Pick a model - AI tracking needs one, and export is blocked until you do.";
                            color: #e0a020;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        HorizontalBox {
                            spacing: 10px;
                            padding: 0;

                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Tip {
                                    tip: "Field: follows the player cluster + ball together (falls back to ball-only if the model has no player class). Ball: follows only the ball. Sweep: a fixed left-right pan with no AI at all - a baseline/debug mode.";
                                    Text { text: "Tracking mode"; color: #ccc; font-size: 12px; }
                                }
                                ComboBox {
                                    model: ["field", "ball", "sweep"];
                                    current-index: root.export-tracking-mode == "ball" ? 1
                                                 : root.export-tracking-mode == "sweep" ? 2
                                                 : 0;
                                    selected(v) => { root.export-tracking-mode = v; }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Tip {
                                    tip: "Runs AI detection every Nth frame; frames in between reuse the last detection. Higher = cheaper but staler positions during fast action.";
                                    Text { text: "Detect every N frames"; color: #ccc; font-size: 12px; }
                                }
                                ComboBox {
                                    model: ["1", "3", "5", "10", "15", "30"];
                                    current-index: root.export-detection-interval == 1 ? 0
                                                 : root.export-detection-interval == 5 ? 2
                                                 : root.export-detection-interval == 10 ? 3
                                                 : root.export-detection-interval == 15 ? 4
                                                 : root.export-detection-interval == 30 ? 5
                                                 : 1;
                                    selected(v) => {
                                        root.export-detection-interval =
                                            v == "1" ? 1 : v == "5" ? 5 : v == "10" ? 10
                                            : v == "15" ? 15 : v == "30" ? 30 : 3;
                                    }
                                }
                            }
                        }

                        LabeledSlider {
                            label: "Ball anchor range";
                            tip: "Before the panner ever sees a ball position, the ball tracker itself requires a raw detection to be within this distance of at least one tracked player - farther detections are dropped as likely false positives (crowd, background). This runs ahead of Ball reach below, so a genuine isolated ball (e.g. a breakaway) can be silently discarded here even with Ball reach raised. Widen it if the panner never even coasts onto a real, far-from-the-pack ball.";
                            minimum: 0.1;
                            maximum: 0.8;
                            value <=> root.export-player-anchor-rad;
                            suffix: " rad";
                            decimals: 2;
                        }

                        LabeledSlider {
                            label: "Ball coast time";
                            tip: "A ball leaving the field ROI looks identical to the tracker as \"no detection this frame\" - the ROI filter drops it before the tracker ever sees it. A ball already being tracked keeps holding its last known position for up to this long before the track is declared lost, same as any other brief detection gap - long enough to bridge a throw-in or a ball briefly rolling out of bounds and being brought back. A ball never tracked in the first place (e.g. a kid's ball just outside the pitch) never starts this countdown, so raising it doesn't make the panner more likely to trigger on that.";
                            minimum: 0.2;
                            maximum: 5.0;
                            value <=> root.export-ball-coast-secs;
                            suffix: " s";
                            decimals: 2;
                        }

                        // Style preset: sets the controls below; tweak after.
                        VerticalLayout {
                            spacing: 4px;
                            Tip {
                                tip: "One-shot preset that overwrites every slider below (framing, cluster mode, lock-pitch, bandwidth, dead-zone, ball weight, FOV) with tuned defaults for that style. You can still tweak any slider afterward.";
                                Text { text: "Style preset"; color: #ccc; font-size: 12px; }
                            }
                            ComboBox {
                                model: ["broadcast", "action", "frame_all"];
                                current-index: root.export-panner-preset == "action" ? 1
                                             : root.export-panner-preset == "frame_all" ? 2
                                             : 0;
                                selected(v) => {
                                    root.export-panner-preset = v;
                                    root.apply-panner-preset(v);
                                }
                            }
                        }

                        // Framing + pitch lock.
                        HorizontalBox {
                            spacing: 10px;
                            padding: 0;

                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Tip {
                                    tip: "Action: aims at the (optionally confidence-weighted) player cluster, with ball pull and dynamic zoom. Frame all: aims at the geometric center of every player, zoomed to fit the whole team.";
                                    Text { text: "Framing"; color: #ccc; font-size: 12px; }
                                }
                                ComboBox {
                                    model: ["action", "frame_all"];
                                    current-index: root.export-framing == "frame_all" ? 1 : 0;
                                    selected(v) => { root.export-framing = v; }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text { text: "Pitch"; color: #ccc; font-size: 12px; }
                                Tip {
                                    tip: "Holds the camera's tilt fixed and pans left/right only. Off by default - the camera follows the action's vertical position too.";
                                    CheckBox {
                                        text: "Lock (horizontal-only)";
                                        checked <=> root.export-lock-pitch;
                                    }
                                }
                            }
                        }

                        // Lookahead is the dominant smoothness lever; give it
                        // a full-width slider. 0 disables the buffer. The VRAM
                        // risk colouring warns when the chosen value won't fit
                        // GPU memory for the loaded source resolution.
                        VramRiskSlider {
                            label: "Lookahead (smoothness)";
                            tip: "Buffers N seconds of future frames so the panner can smooth over past+future and lead the action slightly, instead of reacting frame-by-frame. The dominant lever for smooth AI panning. 0 disables it.";
                            minimum: 0.0;
                            maximum: 2.5;
                            value <=> root.export-lookahead-secs;
                            suffix: "s";
                            green-max: root.lookahead-green-max;
                            red-min: root.lookahead-red-min;
                            risk-active: root.lookahead-risk-active;
                        }

                        Tip {
                            tip: "Buffers the lookahead at 8-bit instead of the source's native bit depth, roughly halving its VRAM cost on 10-bit footage (e.g. DJI Action 4 HEVC) - lets a longer lookahead fit on lower-VRAM cards. No effect on already-8-bit sources. The same buffered frames feed the final render too, so this trades a little gradient smoothness (sky, grass, floodlit surfaces) for memory. Currently also REQUIRED for 10-bit sources, not just a VRAM fallback - leaving it off crashes with a known wgpu texture-copy bug, fix pending.";
                            CheckBox {
                                text: "Reduce lookahead memory (8-bit)";
                                checked <=> root.export-lookahead-reduced-bit-depth;
                            }
                        }

                        Tip {
                            tip: "Runs AI detection's inference call on a background thread instead of blocking the export loop - AI detection is typically the single biggest export-speed bottleneck. Measured 1.2-1.4x faster export across multiple test runs (no change to detection results, purely a timing change - see docs/async-detect-benchmark-v054.md). Costs a real but modest extra ~400MB VRAM (a second loaded model instance), not a doubling of the whole session. Only affects the buffered/export loop (needs Lookahead > 0). Off by default - turn on if your card has VRAM headroom to spare.";
                            CheckBox {
                                text: "Async AI detection (faster export)";
                                checked <=> root.export-async-detect;
                            }
                        }

                        panner-advanced := SectionHeader {
                            title: "Advanced panner";
                            expanded: false;
                        }

                        if panner-advanced.expanded: VerticalLayout {
                            spacing: 8px;

                            HorizontalBox {
                                spacing: 10px;
                                padding: 0;

                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Tip {
                                        tip: "Density (default): follows the tightest knot of players, ignoring stragglers. Trimmed mean: averages all players' positions, trimming outliers - a distant group can still pull the aim before trimming kicks in.";
                                        Text { text: "Cluster mode"; color: #ccc; font-size: 12px; }
                                    }
                                    ComboBox {
                                        model: ["density", "trimmed_mean"];
                                        current-index: root.export-cluster-mode == "trimmed_mean" ? 1 : 0;
                                        selected(v) => { root.export-cluster-mode = v; }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    LabeledSlider {
                                        label: "Ball weight";
                                        tip: "How strongly the ball pulls the aim away from the player cluster (Action framing only) - scaled by ball confidence and distance from the cluster. Forced to 1.0 in Ball tracking mode.";
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.export-ball-weight;
                                        decimals: 2;
                                    }
                                }
                            }

                            LabeledSlider {
                                label: "Cluster bandwidth";
                                tip: "Radius used by Density cluster mode to group nearby players. Wider pulls a looser formation into one cluster; narrower isolates a tight core. No effect in Trimmed mean mode.";
                                minimum: 0.1;
                                maximum: 0.6;
                                value <=> root.export-cluster-bandwidth;
                                suffix: " rad";
                                decimals: 2;
                            }
                            LabeledSlider {
                                label: "Dead-zone";
                                tip: "Camera holds still while the target stays within this radius; larger errors ease in beyond it instead of snapping. Removes micro-wobble on static play - relies on Lookahead to absorb the added latency.";
                                minimum: 0.0;
                                maximum: 0.5;
                                value <=> root.export-dead-zone;
                                suffix: " rad";
                                decimals: 2;
                            }
                            LabeledSlider {
                                label: "Ball reach";
                                tip: "How far the ball may stray from the player cluster and still pull the aim (Action framing only). Beyond this the ball is treated as off-the-action - a stray detection or the far goal - and ignored. Raise it if the camera won't follow a real ball that's broken away from the pack, e.g. into a corner.";
                                minimum: 0.0;
                                maximum: 1.5;
                                value <=> root.export-ball-max-dist-from-cluster;
                                suffix: " rad";
                                decimals: 2;
                            }

                            Tip {
                                tip: "Bounds for the panner's continuously-varying zoom, recomputed every frame from cluster spread and framing. Default is just the starting FOV before any players are detected.";
                                Text { text: "Field of view (degrees)"; color: #ccc; font-size: 12px; }
                            }
                            HorizontalBox {
                                spacing: 10px;
                                padding: 0;
                                LabeledSlider {
                                    label: "Tight";
                                    minimum: 10.0;
                                    maximum: 40.0;
                                    value <=> root.export-fov-tight;
                                    decimals: 0;
                                }
                                LabeledSlider {
                                    label: "Default";
                                    minimum: 20.0;
                                    maximum: 60.0;
                                    value <=> root.export-fov-default;
                                    decimals: 0;
                                }
                                LabeledSlider {
                                    label: "Wide";
                                    minimum: 40.0;
                                    maximum: 90.0;
                                    value <=> root.export-fov-wide;
                                    decimals: 0;
                                }
                            }

                            Tip {
                                tip: "How fast the panner's smoothed values (not the raw target) catch up each frame - an exponential-moving-average rate, not a delay. Low = calm but laggy; a brief, fast-moving ball can leave frame before the camera/zoom ever catches up, even with Ball reach and FOV Wide raised. High = snappier but can reintroduce the wobble those settings were tuned to avoid - raise gradually.";
                                Text { text: "Smoothing speed"; color: #ccc; font-size: 12px; }
                            }
                            HorizontalBox {
                                spacing: 10px;
                                padding: 0;
                                LabeledSlider {
                                    label: "Zoom (FOV)";
                                    tip: "How fast the dynamic zoom catches up to its computed target FOV. Default 0.01 has a ~3s time constant at 30fps - often too slow to reach a wide enough shot before a brief breakaway is over.";
                                    minimum: 0.005;
                                    maximum: 0.3;
                                    value <=> root.export-fov-alpha;
                                    decimals: 3;
                                }
                                LabeledSlider {
                                    label: "Aim (cluster)";
                                    tip: "How fast the aim point catches up to the player cluster centroid. Default 0.012, same slow-time-constant caveat as Zoom.";
                                    minimum: 0.005;
                                    maximum: 0.3;
                                    value <=> root.export-cluster-alpha;
                                    decimals: 3;
                                }
                            }
                        }
                    }

                    Rectangle { height: 10px; }

                    HorizontalBox {
                        spacing: 10px;
                        padding: 0;

                        Rectangle { horizontal-stretch: 1; }

                        if root.export-error-text != "": Text {
                            text: root.export-error-text;
                            color: #e06060;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        FlatButton {
                            text: "Cancel";
                            clicked => { root.export-dialog-open = false; root.export-error-text = ""; }
                        }

                        FlatButton {
                            text: "Start Export";
                            primary: true;
                            // Block when AI tracking is on but no model is
                            // picked - otherwise the export runs with no
                            // tracking and no warning.
                            enabled: root.export-output-path != ""
                                && !(root.export-autocam-enabled && root.export-model-path == "");
                            clicked => {
                                if !root.has-roi {
                                    root.no-roi-warning-open = true;
                                } else {
                                    root.start-export();
                                }
                            }
                        }
                    }
                }
                }  // close ScrollView
            }
        }
        // ── No-ROI export confirmation (modal) ──
        //
        // Rendered after the Export dialog so it stacks on top when both
        // are open (Start Export is clicked from inside that dialog).
        if root.no-roi-warning-open: Rectangle {
            background: root.bg-scrim;
            TouchArea { clicked => { root.no-roi-warning-open = false; } }

            Rectangle {
                width: 420px;
                height: min(parent.height - 60px, 260px);
                background: root.bg-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.border-mid;
                TouchArea {}

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    Text { text: "No field ROI set"; color: root.text-heading; font-size: 18px; font-weight: 600; }

                    Text {
                        text: "This calibration has no field ROI. AI framing and tracking use it to stay on the pitch, so without one the export may frame poorly. Continue anyway?";
                        color: root.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        FlatButton { text: "Cancel"; clicked => { root.no-roi-warning-open = false; } }
                        FlatButton {
                            text: "Export Anyway";
                            primary: true;
                            clicked => {
                                root.no-roi-warning-open = false;
                                root.start-export();
                            }
                        }
                    }
                }
            }
        }

        // ── Overwrite-default-calibration confirmation (modal) ──
        if root.overwrite-default-cal-warning-open: Rectangle {
            background: root.bg-scrim;
            TouchArea { clicked => { root.overwrite-default-cal-warning-open = false; } }

            Rectangle {
                width: 420px;
                height: min(parent.height - 60px, 240px);
                background: root.bg-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.border-mid;
                TouchArea {}

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    Text { text: "Overwrite default calibration?"; color: root.text-heading; font-size: 18px; font-weight: 600; }

                    Text {
                        text: "This is your configured Default Calibration - the fallback used whenever no calibration is otherwise loaded. Saving now will overwrite it with the current session's changes.";
                        color: root.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        FlatButton { text: "Cancel"; clicked => { root.overwrite-default-cal-warning-open = false; } }
                        FlatButton {
                            text: "Overwrite Default";
                            primary: true;
                            clicked => {
                                root.overwrite-default-cal-warning-open = false;
                                root.confirm-save-calibration();
                            }
                        }
                    }
                }
            }
        }

        // ── Lens profile picker dialog (modal) ──
        if root.lens-picker-open: Rectangle {
            background: root.bg-scrim;
            TouchArea { clicked => { root.lens-picker-open = false; } }

            Rectangle {
                width: 520px;
                height: min(parent.height - 80px, 540px);
                background: root.bg-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.border-mid;
                TouchArea {}

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Browse Lens Profiles";
                            color: #fff;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text { text: "Apply to:"; color: #aaa; font-size: 11px; vertical-alignment: center; }
                        ComboBox {
                            model: ["Both", "Left", "Right"];
                            current-value: root.lens-pick-side == "left" ? "Left" : root.lens-pick-side == "right" ? "Right" : "Both";
                            width: 80px;
                            selected(v) => {
                                root.lens-pick-side = v == "Left" ? "left" : v == "Right" ? "right" : "both";
                            }
                        }
                    }

                    LineEdit {
                        text <=> root.lens-search-query;
                        placeholder-text: "Search by camera, lens, resolution...";
                        edited(text) => { root.lens-search-changed(text); }
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 2px;

                            if root.lens-search-results.length == 0 && root.lens-search-query != "": Text {
                                text: "No profiles match your search.";
                                color: #777;
                                font-size: 12px;
                            }

                            if root.lens-search-query == "": Text {
                                text: "Type to search across 4200+ camera profiles.";
                                color: #666;
                                font-size: 12px;
                            }

                            for result[idx] in root.lens-search-results: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: lens-row.has-hover ? #333 : #282828;

                                lens-row := TouchArea {
                                    clicked => {
                                        root.lens-pick(idx, root.lens-pick-side);
                                        root.lens-picker-open = false;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    Text {
                                        text: result;
                                        color: #ddd;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        FlatButton {
                            text: "Load from file...";
                            clicked => { root.lens-pick-file(); }
                        }
                        FlatButton {
                            text: "Close";
                            clicked => { root.lens-picker-open = false; }
                        }
                    }
                }
            }
        }
    }  // close FocusScope key-scope

    // ── Toast stack (floating overlay, bottom-right) ──
    // Placed as a direct child of the Window (outside FocusScope and
    // VerticalLayout) so it overlays everything without affecting layout.
    ToastStack {
        toasts: root.toasts;
        right-inset: root.controls-open ? root.right-panel-width : 0px;
        dismissed(id) => { root.toast-dismissed(id); }
    }
}

// Floating debug-log window: a separate top-level window (not a modal
// overlay) so it can be dragged beside the main window and stays open
// independently while the user works. Rust shows/hides it (see
// `on_open_debug_window` in main.rs) and pushes periodic log snapshots
// into `log-text` while it's visible. Always dark - a log viewer, not a
// themed app surface, so it doesn't need to track the main window's
// dark/light toggle.
export component DebugWindow inherits Window {
    title: "Reco - Debug Log";
    width: 640px;
    height: 520px;
    background: #202327;

    in-out property <string> log-text: "";

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "Debug log";
            color: #f0f2f4;
            font-size: 16px;
            font-weight: 600;
        }

        Rectangle { height: 1px; background: #2a2e33; }

        Rectangle {
            vertical-stretch: 1;
            background: #101214;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2a2e33;
            clip: true;

            ScrollView {
                TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    text: root.log-text == "" ? "(no log output yet)" : root.log-text;
                    color: #ccc;
                    font-size: 10px;
                    font-family: "Consolas";
                    read-only: true;
                    wrap: word-wrap;
                    single-line: false;
                }
            }
        }
    }
}
